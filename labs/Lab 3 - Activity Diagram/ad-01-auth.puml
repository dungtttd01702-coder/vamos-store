@startuml ad-01-auth
title QUY TRÌNH ĐĂNG KÝ VÀ ĐĂNG NHẬP - VAMOS STORE

<style>
  activityDiagram {
    BackgroundColor #FFFFFF
    LineColor #1E293B
    FontName "Segoe UI", "Inter", Arial, Sans-Serif
    FontSize 12
    RoundCorner 10
    Diamond {
      BackgroundColor #FEF3C7
      LineColor #D97706
      FontColor #92400E
      FontSize 11
    }
    activity {
      BackgroundColor #F8FAFC
      LineColor #334155
      FontColor #0F172A
    }
    arrow {
      LineColor #2563EB
      FontColor #1D4ED8
      FontSize 11
    }
    partition {
      BackgroundColor #F1F5F9
      LineColor #94A3B8
      FontColor #0F172A
      RoundCorner 8
    }
  }
</style>

|#EFF6FF|Người dùng (Guest)|
start
:Mở trang web VAMOS STORE;
if (Đã có tài khoản?) then (Có)
    :Chọn Đăng nhập;
    :Nhập Email và Mật khẩu;
    |#F8FAFC|Hệ thống VAMOS STORE|
    :Kiểm tra tài khoản theo Email;
    if (Email tồn tại?) then (Không)
        :Báo lỗi "Email hoặc mật khẩu không chính xác";
        stop
    else (Có)
        if (Tài khoản bị khóa?) then (Có)
            :Báo lỗi "Tài khoản bị tạm khóa";
            stop
        else (Không)
            :So sánh mật khẩu với mã băm bcrypt;
            if (Mật khẩu khớp?) then (Không)
                :Báo lỗi "Email hoặc mật khẩu không chính xác";
                stop
            else (Có)
                :Tạo Session bảo mật (req.session.user);
                if (Vai trò là Admin?) then (Admin)
                    :Điều hướng đến /admin/dashboard;
                else (Customer)
                    :Điều hướng về Trang chủ / Giỏ hàng;
                endif
                stop
            endif
        endif
    endif
else (Chưa)
    |#EFF6FF|Người dùng (Guest)|
    :Chọn Đăng ký;
    :Nhập Họ tên, Email, SĐT, Mật khẩu, Xác nhận MK;
    |#F8FAFC|Hệ thống VAMOS STORE|
    :Validate dữ liệu bắt buộc & định dạng;
    :Kiểm tra tính duy nhất của Email;
    if (Email đã tồn tại?) then (Có)
        :Báo lỗi "Email đã được đăng ký";
        stop
    else (Không)
        if (Xác nhận MK khớp?) then (Không)
            :Báo lỗi "Mật khẩu xác nhận không khớp";
            stop
        else (Có)
            :Băm mật khẩu bằng bcrypt;
            :Tạo tài khoản mới (role = CUSTOMER, status = active);
            :Thông báo đăng ký thành công;
            :Chuyển hướng đến trang Đăng nhập;
            stop
        endif
    endif
endif
@enduml
