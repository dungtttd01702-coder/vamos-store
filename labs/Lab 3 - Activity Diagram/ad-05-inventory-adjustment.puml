@startuml ad-05-inventory-adjustment
title QUY TRÌNH ĐIỀU CHỈNH TỒN KHO THỦ CÔNG - VAMOS STORE

<style>
  activityDiagram {
    BackgroundColor #FFFFFF
    LineColor #1E293B
    FontName "Segoe UI", "Inter", Arial, Sans-Serif
    FontSize 12
    RoundCorner 10
    Diamond {
      BackgroundColor #FEF3C7
      LineColor #D97706
      FontColor #92400E
      FontSize 11
    }
    activity {
      BackgroundColor #F8FAFC
      LineColor #334155
      FontColor #0F172A
    }
    arrow {
      LineColor #2563EB
      FontColor #1D4ED8
      FontSize 11
    }
    partition {
      BackgroundColor #F1F5F9
      LineColor #94A3B8
      FontColor #0F172A
      RoundCorner 8
    }
  }
</style>

|#F0FDF4|Quản trị viên (Admin)|
start
:Mở Quản lý tồn kho;
:Tìm kiếm biến thể sản phẩm theo SKU hoặc Tên;
:Bấm nút "Điều chỉnh tồn";
|#F8FAFC|Hệ thống VAMOS STORE|
:Hiển thị số lượng tồn hiện tại của biến thể;
:Hiển thị form nhập: Loại điều chỉnh, Số lượng, Lý do bắt buộc;

|#F0FDF4|Quản trị viên (Admin)|
:Chọn loại điều chỉnh (Nhập thêm / Xuất kiểm kê / Hàng hỏng);
:Nhập số lượng thay đổi;
:Nhập Lý do điều chỉnh (bắt buộc);
:Bấm "Xác nhận điều chỉnh";

|#F8FAFC|Hệ thống VAMOS STORE|
:Kiểm tra lý do không được để trống;
if (Thiếu lý do?) then (Có)
    :Báo lỗi "Vui lòng nhập lý do điều chỉnh tồn kho";
    stop
else (Đầy đủ)
    :Tính toán số tồn kho mới (new_quantity);
    if (new_quantity < 0?) then (Âm tồn)
        :Báo lỗi "Số lượng tồn kho không thể âm";
        stop
    else (Hợp lệ >= 0)
        |#FEF2F2|Hệ thống (Database Transaction)|
        :Bắt đầu Database Transaction;
        :Cập nhật product_variants.stock_quantity = new_quantity;
        :Tạo bản ghi kiểm toán trong inventory_transactions\n(variant_id, old_qty, new_qty, change_qty, reason, admin_id);
        :Commit Transaction;
        |#F0FDF4|Quản trị viên (Admin)|
        :Nhận thông báo "Điều chỉnh tồn kho thành công";
        :Danh sách tồn kho được cập nhật tức thời;
        stop
    endif
endif
@enduml
