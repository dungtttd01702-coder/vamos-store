@startuml ad-03-order-processing
title QUY TRÌNH XỬ LÝ ĐƠN HÀNG NỘI BỘ - VAMOS STORE

<style>
  activityDiagram {
    BackgroundColor #FFFFFF
    LineColor #1E293B
    FontName "Segoe UI", "Inter", Arial, Sans-Serif
    FontSize 12
    RoundCorner 10
    Diamond {
      BackgroundColor #FEF3C7
      LineColor #D97706
      FontColor #92400E
      FontSize 11
    }
    activity {
      BackgroundColor #F8FAFC
      LineColor #334155
      FontColor #0F172A
    }
    arrow {
      LineColor #2563EB
      FontColor #1D4ED8
      FontSize 11
    }
    partition {
      BackgroundColor #F1F5F9
      LineColor #94A3B8
      FontColor #0F172A
      RoundCorner 8
    }
  }
</style>

|#F0FDF4|Quản trị viên (Admin)|
start
:Mở Danh sách đơn hàng quản trị;
:Tìm kiếm và chọn một đơn hàng;
|#F8FAFC|Hệ thống VAMOS STORE|
:Tải chi tiết đơn, thông tin người nhận, snapshot sản phẩm;
:Hiển thị trạng thái hiện tại và các hành động được phép;

|#F0FDF4|Quản trị viên (Admin)|
if (Đơn hàng đang ở trạng thái nào?) then (PENDING - Chờ xác nhận)
    if (Khách hủy hoặc Đơn giả mạo?) then (Hủy đơn)
        :Chọn "Hủy đơn nội bộ" & Nhập lý do bắt buộc;
        |#FEF2F2|Hệ thống VAMOS STORE|
        :Bắt đầu Transaction;
        :Đổi order_status = CANCELLED;
        :Tự động hoàn trả tồn kho các biến thể;
        :Ghi log inventory_transactions & order_status_histories;
        :Commit Transaction;
        :Báo hủy đơn thành công;
        stop
    else (Hợp lệ)
        :Bấm "Xác nhận đơn";
        |#F8FAFC|Hệ thống VAMOS STORE|
        :Cập nhật order_status = CONFIRMED;
        :Lưu order_status_histories;
    endif
elseif (CONFIRMED - Đã xác nhận)
    :Bấm "Chuyển đóng gói / Chuẩn bị hàng";
    |#F8FAFC|Hệ thống VAMOS STORE|
    :Cập nhật order_status = PROCESSING;
    :Lưu order_status_histories;
elseif (PROCESSING - Đang chuẩn bị)
    :Bấm "Bàn giao giao hàng";
    |#F8FAFC|Hệ thống VAMOS STORE|
    :Cập nhật order_status = SHIPPING;
    :Lưu order_status_histories;
elseif (SHIPPING - Đang giao)
    :Bấm "Xác nhận giao thành công & Đã thu COD";
    |#F8FAFC|Hệ thống VAMOS STORE|
    :Cập nhật order_status = COMPLETED;
    :Tự động cập nhật payment_status = PAID;
    :Ghi nhận doanh thu thực tế;
    :Lưu order_status_histories;
endif

|#F0FDF4|Quản trị viên (Admin)|
:Xem thông báo cập nhật trạng thái thành công;
stop
@enduml
