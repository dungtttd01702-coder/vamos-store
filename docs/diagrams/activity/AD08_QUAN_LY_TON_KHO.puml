@startuml
title Sơ đồ hoạt động — Quản lý tồn kho & thẻ kho (AD08/AD12)

skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam ActivityFontSize 12
skinparam ActivityBorderColor #1e293b
skinparam ActivityBackgroundColor #ffffff
skinparam ActivityDiamondBorderColor #b91c1c
skinparam ActivityDiamondBackgroundColor #fef2f2
skinparam ActivityDiamondFontSize 11
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam SwimlaneTitleFontSize 13
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneBorderColor #94a3b8
skinparam SwimlaneWidth same

|Quản trị viên (Admin)|
start
:Mở bảng quản lý tồn kho sản phẩm;
:Chọn biến thể SKU cần điều chỉnh;
:Nhập số lượng mới và lý do kiểm kê;
:Nhấn Lưu cập nhật;

|Hệ thống|
:Tiếp nhận số lượng và lý do;
:Kiểm tra tính hợp lệ của số lượng nhập;
if (Số lượng hợp lệ (>= 0)?) then (Đúng)
  :Cập nhật số lượng tồn kho của biến thể SKU;
  :Ghi nhật ký thẻ kho bất biến (lý do, chênh lệch);
  :Thông báo điều chỉnh tồn kho thành công;
  |Quản trị viên (Admin)|
  :Xem số lượng cập nhật và lịch sử thẻ kho;
  stop
else (Sai)
  :Thông báo lỗi số lượng không hợp lệ;
  |Quản trị viên (Admin)|
  :Nhập lại số lượng chính xác;
  stop
endif
@enduml