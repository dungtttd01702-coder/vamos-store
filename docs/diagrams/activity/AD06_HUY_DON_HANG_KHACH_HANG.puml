@startuml
title Sơ đồ hoạt động — Khách hàng hủy đơn hàng (AD06/AD10)

skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 13
skinparam roundCorner 10
skinparam shadowing false

skinparam ActivityFontSize 13
skinparam ActivityFontColor #0f172a
skinparam ActivityBorderColor #334155
skinparam ActivityBorderThickness 1.5
skinparam ActivityBackgroundColor #ffffff

skinparam ActivityDiamondFontSize 12
skinparam ActivityDiamondFontColor #991b1b
skinparam ActivityDiamondBorderColor #ef4444
skinparam ActivityDiamondBorderThickness 1.5
skinparam ActivityDiamondBackgroundColor #fef2f2

skinparam ArrowColor #2563eb
skinparam ArrowFontSize 12
skinparam ArrowFontColor #1e293b
skinparam ArrowThickness 1.5

skinparam SwimlaneTitleFontSize 15
skinparam SwimlaneTitleFontStyle bold
skinparam SwimlaneTitleFontColor #0f172a
skinparam SwimlaneBorderColor #cbd5e1
skinparam SwimlaneBorderThickness 1.5
skinparam SwimlaneWidth 380

|Người dùng|
start
:Truy cập danh sách đơn hàng trong tài khoản cá nhân;
:Chọn đơn hàng cần hủy và nhấn nút "Hủy đơn hàng";
:Chọn lý do hủy và xác nhận yêu cầu;

|Hệ thống|
:Tiếp nhận yêu cầu hủy đơn;
:Kiểm tra trạng thái hiện tại của đơn hàng;

if (Đơn hàng đang ở trạng thái Chờ xử lý (PENDING)?) then (Đúng)
  |Hệ thống|
  :Kích hoạt giao dịch CSDL (Transaction);
  :Cập nhật trạng thái đơn hàng thành Đã hủy (CANCELLED);
  :Cộng hoàn trả số lượng vào tồn kho biến thể SKU;
  :Ghi nhận giao dịch hoàn kho vào sổ thẻ kho (inventory_transactions);
  :Phục hồi lượt sử dụng voucher đã dùng (nếu có);
  :Cam kết giao dịch và hiển thị thông báo hủy đơn thành công;
  |Người dùng|
  :Nhận thông báo hủy thành công và thấy trạng thái Đã hủy;
  stop
else (Sai)
  |Hệ thống|
  :Từ chối hủy trực tiếp trên giao diện;
  :Thông báo đơn hàng đã xác nhận/đang giao, không thể tự hủy;
  |Người dùng|
  :Liên hệ hotline chăm sóc khách hàng 1900 2126 để được hỗ trợ;
  stop
endif
@enduml