@startuml AD03_PASSWORD_RESET
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B

title SƠ ĐỒ HOẠT ĐỘNG: KHÔI PHỤC MẬT KHẨU (AD03 — PASSWORD RESET)\n[BẢN THIẾT KẾ KIẾN TRÚC — CHƯA TRIỂN KHAI / NOT IMPLEMENTED]

legend top left
  |= Ký hiệu |= Trạng thái triển khai thực tế |
  |<#FFF1F2>| **Chưa triển khai trong mã nguồn (Not Implemented)** |
  |<#F0FDF4>| **Đã sẵn sàng ở tầng CSDL (Database Schema Ready)** |
endlegend

|Người dùng (User)|
start
:Yêu cầu khôi phục mật khẩu;

|Hệ thống (Web App)|
note right #FFF1F2
  **HIỆN TRẠNG THỰC TẾ (CURRENT IMPLEMENTATION STATUS):**
  - CSDL đã có bảng **password_reset_tokens** (migration 001).
  - Chưa triển khai route (/auth/forgot-password, /auth/reset-password).
  - Chưa tích hợp dịch vụ gửi email (Nodemailer / SMTP Service).
  - Chưa có controller xử lý logic tạo token và xác thực token.
  *(Chức năng được phân loại: Designed Only / Not Implemented)*
end note

partition #FFF1F2 "Luồng Thiết kế Dự kiến (Future Implementation)" {
  |Người dùng (User)|
  :Nhập địa chỉ Email tài khoản;
  :Nhấn "Gửi liên kết đặt lại mật khẩu";

  |Hệ thống (Web App)|
  :Kiểm tra định dạng email;
  :Truy vấn kiểm tra tài khoản;

  |Cơ sở Dữ liệu (SQL Server)|
  :SELECT id, email, status FROM users WHERE email = @email;

  |Hệ thống (Web App)|
  if (Email tồn tại và tài khoản active?) then ([Không])
    :Hiển thị thông báo chung (chống rà quét tài khoản):\n"Nếu email tồn tại, hệ thống đã gửi liên kết khôi phục";
    stop
  else ([Có])
    :Sinh chuỗi token ngẫu nhiên an toàn (crypto.randomBytes);\nBăm token hoặc lưu mã hash;
    :Thiết lập thời gian hết hạn (expires_at = NOW + 15 phút);

    |Cơ sở Dữ liệu (SQL Server)|
    #F0FDF4:INSERT INTO password_reset_tokens\n(user_id, token_hash, expires_at, created_at);

    |Hệ thống (Web App)|
    :Tạo liên kết đặt lại mật khẩu dạng:\nhttps://vamos.store/auth/reset-password?token=...;
    :Gửi email chứa liên kết đến hòm thư người dùng (SMTP Service);

    |Người dùng (User)|
    :Mở hòm thư email cá nhân;
    :Nhấp vào liên kết xác thực trong email;

    |Hệ thống (Web App)|
    :Nhận request GET /auth/reset-password?token=...;
    :Truy vấn kiểm tra tính hợp lệ của token;

    |Cơ sở Dữ liệu (SQL Server)|
    :SELECT user_id, expires_at, used_at\nFROM password_reset_tokens WHERE token_hash = @hash;

    |Hệ thống (Web App)|
    if (Token hợp lệ, chưa sử dụng (used_at IS NULL) và chưa hết hạn?) then ([Không])
      :Hiển thị lỗi: "Liên kết khôi phục không hợp lệ hoặc đã hết hạn";
      stop
    else ([Hợp lệ])
      :Hiển thị form nhập mật khẩu mới;

      |Người dùng (User)|
      :Nhập mật khẩu mới và xác nhận mật khẩu;
      :Nhấn "Lưu mật khẩu mới";

      |Hệ thống (Web App)|
      :Validate mật khẩu mới (tối thiểu 6 ký tự, khớp nhau);
      :Băm mật khẩu mới bằng bcrypt;
      :Mở Transaction cập nhật mật khẩu;

      |Cơ sở Dữ liệu (SQL Server)|
      partition "SQL Server Transaction" {
        :BEGIN TRANSACTION;
        :UPDATE users SET password_hash = @newHash, updated_at = GETDATE();
        :UPDATE password_reset_tokens SET used_at = GETDATE();
        :COMMIT TRANSACTION;
      }

      |Hệ thống (Web App)|
      :Hiển thị thông báo đổi mật khẩu thành công;
      :Chuyển hướng người dùng về trang Đăng nhập (/auth/login);

      |Người dùng (User)|
      :Đăng nhập bằng mật khẩu mới vừa đổi;
      stop
    endif
  endif
}

@enduml

