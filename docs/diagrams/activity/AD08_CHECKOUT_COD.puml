@startuml AD08_CHECKOUT_COD
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B

title SƠ ĐỒ HOẠT ĐỘNG: ĐẶT HÀNG COD (AD08 — CHECKOUT COD)\nHỆ THỐNG VAMOS STORE

|Khách hàng (Customer)|
start
:Truy cập trang thanh toán (/checkout);

|Hệ thống (Web App)|
:Xác thực phiên đăng nhập (requireAuth);
if (Đã đăng nhập tài khoản Customer?) then ([Chưa])
  :Chuyển hướng đến /auth/login?returnUrl=/checkout;
  stop
else ([Hợp lệ])
  :Tải sổ địa chỉ và thông tin giỏ hàng;
endif

|Khách hàng (Customer)|
:Chọn địa chỉ giao hàng có sẵn (hoặc nhập địa chỉ mới);
:Nhập ghi chú đơn hàng (nếu có);
:Nhập mã giảm giá Voucher (nếu có);
:Xác nhận phương thức thanh toán: COD (Thanh toán khi nhận hàng);
:Nhấn nút "Đặt hàng ngay (COD)";

|Hệ thống (Web App)|
:Validate thông tin người nhận:
- Họ tên người nhận không rỗng
- Số điện thoại 10 số hợp lệ
- Địa chỉ giao hàng chi tiết;

if (Thông tin giao hàng hợp lệ?) then ([Không])
  :Báo lỗi: "Vui lòng cung cấp đầy đủ họ tên, SĐT và địa chỉ giao hàng";
  stop
else ([Hợp lệ])
  :Bắt đầu quy trình tạo đơn hàng trong Transaction CSDL\n(orderService.createCodOrder);

  |Cơ sở Dữ liệu (SQL Server)|
  partition "SQL Server Transaction" {
    :BEGIN TRANSACTION;

    :Đọc và khóa giỏ hàng của khách hàng:\nSELECT ci.*, pv.stock_quantity, pv.sku, p.name, p.status\nFROM carts ct WITH (UPDLOCK, ROWLOCK)\nJOIN cart_items ci WITH (UPDLOCK, HOLDLOCK) ON ci.cart_id = ct.id ...;

    |Hệ thống (Web App)|
    if (Giỏ hàng trống?) then ([Trống])
      |Cơ sở Dữ liệu (SQL Server)|
      :ROLLBACK TRANSACTION;
      |Hệ thống (Web App)|
      :Báo lỗi: "Giỏ hàng của bạn đang trống";
      stop
    else ([Có sản phẩm])
      :Tính tiền hàng: subtotal = SUM(unit_price * quantity);
      :Tính cước vận chuyển:
      shippingFee = (subtotal >= 500,000) ? 0 : 30,000;
    endif

    if (Khách hàng có áp dụng mã Voucher?) then ([Có mã])
      |Cơ sở Dữ liệu (SQL Server)|
      :Khóa và kiểm tra voucher:\nSELECT * FROM vouchers WITH (UPDLOCK, ROWLOCK)\nWHERE code = @code AND is_active = 1\n  AND start_date <= GETDATE() AND end_date >= GETDATE();

      |Hệ thống (Web App)|
      if (Voucher không tồn tại hoặc hết hạn?) then ([Không hợp lệ])
        |Cơ sở Dữ liệu (SQL Server)|
        :ROLLBACK TRANSACTION;
        |Hệ thống (Web App)|
        :Báo lỗi: "Mã giảm giá không tồn tại hoặc đã hết hạn";
        stop
      else ([Hợp lệ thời gian])
        if (subtotal < min_order_value?) then ([Chưa đạt giá trị tối thiểu])
          |Cơ sở Dữ liệu (SQL Server)|
          :ROLLBACK TRANSACTION;
          |Hệ thống (Web App)|
          :Báo lỗi: "Đơn hàng chưa đạt giá trị tối thiểu để áp dụng voucher";
          stop
        else if (usage_limit > 0 && used_count >= usage_limit) then ([Hết lượt toàn hệ thống])
          |Cơ sở Dữ liệu (SQL Server)|
          :ROLLBACK TRANSACTION;
          |Hệ thống (Web App)|
          :Báo lỗi: "Mã giảm giá đã hết lượt sử dụng";
          stop
        else
          |Cơ sở Dữ liệu (SQL Server)|
          :Kiểm tra quy tắc 1 voucher / 1 khách hàng (Q8):\nSELECT 1 FROM voucher_usages WITH (UPDLOCK, ROWLOCK)\nWHERE voucher_id = @vId AND user_id = @userId;

          |Hệ thống (Web App)|
          if (Khách hàng đã từng sử dụng voucher này?) then ([Đã từng dùng])
            |Cơ sở Dữ liệu (SQL Server)|
            :ROLLBACK TRANSACTION;
            |Hệ thống (Web App)|
            :Báo lỗi: "Mỗi tài khoản chỉ được sử dụng mã giảm giá này 1 lần duy nhất";
            stop
          else ([Chưa từng dùng])
            :Tính số tiền giảm: discountAmount;\nTăng vouchers.used_count = used_count + 1;
          endif
        endif
      endif
    else ([Không dùng])
      :discountAmount = 0;
    endif

    |Hệ thống (Web App)|
    :Tính tổng thanh toán: totalAmount = subtotal - discountAmount + shippingFee;
    :Sinh mã đơn hàng duy nhất (VAMYYMMDD-XXXX);

    |Hệ thống (Web App)|
    :Duyệt kiểm tra từng mặt hàng trong giỏ;
    while (Còn mặt hàng trong giỏ?) is ([Tiếp tục])
      |Cơ sở Dữ liệu (SQL Server)|
      :Khóa biến thể sản phẩm:\nSELECT stock_quantity, status FROM product_variants WITH (UPDLOCK, ROWLOCK)\nWHERE id = @variantId;

      |Hệ thống (Web App)|
      if (Số lượng < 1 hoặc > 10 đôi?) then ([Vượt hạn mức])
        |Cơ sở Dữ liệu (SQL Server)|
        :ROLLBACK TRANSACTION;
        |Hệ thống (Web App)|
        :Báo lỗi: "Vượt quá hạn mức bán lẻ (tối đa 10 đôi/sản phẩm)";
        stop
      else if (Sản phẩm hoặc biến thể không active?) then ([Ngừng bán])
        |Cơ sở Dữ liệu (SQL Server)|
        :ROLLBACK TRANSACTION;
        |Hệ thống (Web App)|
        :Báo lỗi: "Sản phẩm hiện đã ngừng kinh doanh";
        stop
      else if (stock_quantity < quantity?) then ([Hết hàng trong kho])
        |Cơ sở Dữ liệu (SQL Server)|
        :ROLLBACK TRANSACTION;
        |Hệ thống (Web App)|
        :Báo lỗi: "Sản phẩm không đủ số lượng tồn kho khả dụng";
        stop
      else ([Đủ tồn kho])
        |Cơ sở Dữ liệu (SQL Server)|
        :Trừ tồn kho vật lý:\nUPDATE product_variants SET stock_quantity = stock_quantity - @qty;
        :Ghi sổ kiểm toán kho:\nINSERT INTO inventory_transactions\n(variant_id, user_id, old_qty, new_qty, change_qty = -qty, reason);
      endif
    endwhile ([Hoàn tất duyệt giỏ])

    |Cơ sở Dữ liệu (SQL Server)|
    :Tạo bản ghi đơn hàng mới:\nINSERT INTO orders (\n  order_code, user_id, recipient_name_snapshot, recipient_phone_snapshot,\n  delivery_address_snapshot, subtotal, discount_amount, shipping_fee,\n  total_amount, voucher_id, voucher_code_snapshot, payment_method='COD',\n  payment_status='UNPAID', order_status='PENDING', customer_note\n) OUTPUT INSERTED.id;

    if (Có voucherId?) then ([Có])
      :Ghi nhận lịch sử sử dụng voucher:\nINSERT INTO voucher_usages (voucher_id, user_id, order_id, used_at);
    endif

    :Ghi các dòng sản phẩm vào chi tiết đơn:\nINSERT INTO order_items (\n  order_id, product_variant_id, product_name_snapshot, sku_snapshot,\n  size_snapshot, color_snapshot, unit_price, quantity, line_total\n);

    :Ghi nhận lịch sử trạng thái ban đầu:\nINSERT INTO order_status_histories\n(order_id, changed_by = userId, previous_status = NULL, new_status = 'PENDING', note);

    :Dọn sạch giỏ hàng của người dùng:\nDELETE FROM cart_items WHERE cart_id = @cartId;

    :COMMIT TRANSACTION;
  }

  |Hệ thống (Web App)|
  :Cập nhật lại số đếm giỏ hàng trong Session: req.session.cartCount = 0;
  :Chuyển hướng đến trang đặt hàng thành công (/checkout/success/:id);

  |Khách hàng (Customer)|
  :Nhận mã đơn hàng và hướng dẫn nhận hàng COD;
  stop
endif

@enduml

