@startuml AD10_CUSTOMER_CANCEL_ORDER
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B

title SƠ ĐỒ HOẠT ĐỘNG: KHÁCH HÀNG TỰ HỦY ĐƠN HÀNG (AD10 — CUSTOMER CANCEL ORDER)\nHỆ THỐNG VAMOS STORE

|Khách hàng (Customer)|
start
:Xem chi tiết đơn hàng (/account/orders/:id);\nĐơn hàng đang ở trạng thái Chờ xác nhận (PENDING);
:Nhấn nút "Hủy đơn hàng";
:Nhập lý do hủy đơn (hoặc chọn lý do mặc định);
:Xác nhận yêu cầu hủy đơn hàng;

|Hệ thống (Web App)|
:Nhận request POST /account/orders/:id/cancel;
:Xác thực tài khoản (requireAuth);\nLấy userId từ req.session.user.id;
:Gọi orderService.cancelOrder(orderId, userId, reason);

|Cơ sở Dữ liệu (SQL Server)|
partition "SQL Server Transaction" {
  :BEGIN TRANSACTION;

  :Khóa và kiểm tra quyền sở hữu đơn hàng:\nSELECT id, order_code, order_status, payment_status\nFROM orders WITH (UPDLOCK, ROWLOCK)\nWHERE id = @orderId AND user_id = @userId;

  |Hệ thống (Web App)|
  if (Tìm thấy đơn hàng và đúng chủ sở hữu?) then ([Không tìm thấy / Sai quyền])
    |Cơ sở Dữ liệu (SQL Server)|
    :ROLLBACK TRANSACTION;
    |Hệ thống (Web App)|
    :Báo lỗi: "Không tìm thấy đơn hàng hoặc bạn không có quyền hủy";
    stop
  else ([Hợp lệ])
    if (order_status == 'CANCELLED'?) then ([Đã bị hủy từ trước])
      |Cơ sở Dữ liệu (SQL Server)|
      :ROLLBACK TRANSACTION;
      |Hệ thống (Web App)|
      :Báo lỗi: "Đơn hàng đã ở trạng thái ĐÃ HỦY, không thể hủy thêm lần nữa"\n(Chống hoàn kho lặp / Anti Double-Restock);
      stop
    else if (order_status != 'PENDING'?) then ([Đã được xác nhận / Đang xử lý / Giao hàng])
      |Cơ sở Dữ liệu (SQL Server)|
      :ROLLBACK TRANSACTION;
      |Hệ thống (Web App)|
      :Báo lỗi: "Đơn hàng đã được tiếp nhận xử lý.\nQuý khách chỉ được tự hủy khi đơn hàng đang ở trạng thái 'PENDING'.";
      stop
    else ([Đủ điều kiện hủy: order_status == 'PENDING'])
    endif
  endif

  |Cơ sở Dữ liệu (SQL Server)|
  :Truy vấn danh sách mặt hàng cần hoàn kho:\nSELECT product_variant_id, quantity, product_name_snapshot\nFROM order_items WHERE order_id = @orderId;

  |Hệ thống (Web App)|
  :Duyệt từng mặt hàng để hoàn trả số lượng tồn kho;
  while (Còn mặt hàng trong đơn?) is ([Tiếp tục])
    |Cơ sở Dữ liệu (SQL Server)|
    :Khóa biến thể sản phẩm:\nSELECT stock_quantity FROM product_variants WITH (UPDLOCK, ROWLOCK)\nWHERE id = @variantId;
    :Cộng trả lại số tồn kho:\nUPDATE product_variants\nSET stock_quantity = stock_quantity + @qty, updated_at = GETDATE()\nWHERE id = @variantId;
    :Ghi sổ kiểm toán kho:\nINSERT INTO inventory_transactions (\n  variant_id, user_id = userId, old_quantity, new_quantity,\n  change_quantity = +qty, reason = 'Hoàn tồn kho do khách hủy đơn'\n);
  endwhile ([Hoàn tất hoàn kho])

  |Cơ sở Dữ liệu (SQL Server)|
  :Cập nhật trạng thái đơn hàng:\nUPDATE orders SET order_status = 'CANCELLED', updated_at = GETDATE()\nWHERE id = @orderId;

  if (Đơn hàng có áp dụng Voucher?) then ([Có Voucher])
    :Giải phóng hạn mức sử dụng Voucher:\nDELETE FROM voucher_usages WHERE order_id = @orderId;\nUPDATE vouchers SET used_count = CASE WHEN used_count > 0 THEN used_count - 1 ELSE 0 END\nWHERE id = @voucherId;
    note right
      Cho phép khách hàng
      tái sử dụng mã voucher
      cho đơn hàng tiếp theo
    end note
  else ([Không có Voucher])
  endif

  :Ghi nhận lịch sử trạng thái đơn hàng:\nINSERT INTO order_status_histories (\n  order_id, changed_by = userId, previous_status = 'PENDING',\n  new_status = 'CANCELLED', note = 'Khách hàng tự hủy đơn: ' + reason\n);

  :COMMIT TRANSACTION;
}

|Hệ thống (Web App)|
:Chuyển hướng về trang chi tiết đơn hàng: /account/orders/:id?cancelled=true;

|Khách hàng (Customer)|
:Nhận thông báo: "Đơn hàng đã được hủy thành công";\nTrạng thái đơn hàng chuyển sang nhãn "ĐÃ HỦY (CANCELLED)";
stop

@enduml

