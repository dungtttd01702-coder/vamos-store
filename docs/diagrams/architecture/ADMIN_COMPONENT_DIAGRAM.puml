@startuml ADMIN_COMPONENT_DIAGRAM
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B
skinparam componentStyle uml2

title SƠ ĐỒ THÀNH PHẦN: PHÂN HỆ QUẢN TRỊ HỆ THỐNG (ADMIN COMPONENT)\nHỆ THỐNG THƯƠNG MẠI ĐIỆN TỬ VAMOS STORE

package "Tầng Giao diện Quản trị (Admin Presentation Tier)" #F1F5F9 {
  component [Khung Quản trị (layouts/admin.pug)] as AdminLayout
  component [Quản lý Đơn hàng (pages/admin/orders.pug)] as ViewAdminOrders
  component [Quản lý Kho hàng (pages/admin/inventory.pug)] as ViewAdminInv
  component [Quản lý Sản phẩm (pages/admin/products.pug)] as ViewAdminProds
  component [Quản lý Voucher (pages/admin/vouchers.pug)] as ViewAdminVouch
  component [Quản lý Khách hàng (pages/admin/customers.pug)] as ViewAdminCust
  component [Quản lý Danh mục/Banner (pages/admin/categories.pug)] as ViewAdminCats
}

package "Tầng Điều tuyến & Kiểm soát Quyền (Routing & Security Guard)" #EFF6FF {
  component [Admin Router\n(src/routes/admin.routes.js)] as AdminRouter
  component [Admin Authorization Guard\n(src/middlewares/auth.middleware.js - requireAdmin)] as AdminGuard
  
  AdminRouter --> AdminGuard : Áp dụng cho mọi route /admin/*
}

AdminLayout --> AdminRouter
ViewAdminOrders --> AdminRouter : POST /admin/orders/:id/status
ViewAdminInv --> AdminRouter : POST /admin/inventory/adjust
ViewAdminProds --> AdminRouter : POST /admin/products/create, /edit, /toggle
ViewAdminVouch --> AdminRouter : POST /admin/vouchers/create, /toggle
ViewAdminCust --> AdminRouter : POST /admin/customers/:id/toggle-status
ViewAdminCats --> AdminRouter : POST /admin/categories/create, /brands/create

package "Tầng Điều khiển Quản trị (Admin Controller Tier)" #F0FDF4 {
  component [Admin Controller\n(src/controllers/admin.controller.js)] as AdminCtrl
  
  AdminGuard --> AdminCtrl
}

package "Tầng Dịch vụ Đơn hàng Phối hợp (Service Tier)" #FEF3C7 {
  component [Order Service\n(src/services/order.service.js)] as OrderService
  
  AdminCtrl --> OrderService : updateOrderStatusByAdmin(\n  orderId, newStatus, adminUserId, note\n)
}

package "Tầng Truy xuất CSDL (Data Access Engine)" #EEF2FF {
  component [Database Access Engine\n(src/config/database.js)] as DbEngine
  
  AdminCtrl --> DbEngine : query() / sql.Transaction
  OrderService --> DbEngine : Transaction & UPDLOCK
}

package "Tầng Cơ sở Dữ liệu (Microsoft SQL Server)" #FFF1F2 {
  database [SQL Server (vamos_store_db)] as SqlDb {
    [orders & order_status_histories] as TblOrders
    [product_variants & inventory_transactions] as TblInv
    [products & product_images & categories & brands] as TblCatalog
    [vouchers & voucher_usages] as TblVouch
    [users (role, status)] as TblUsers
    [banners] as TblBanners
  }
  
  DbEngine <--> TblOrders : Cập nhật State Machine, Auto-Paid
  DbEngine <--> TblInv : Khóa dòng, kiểm tra phi âm, ghi log
  DbEngine <--> TblCatalog : Transaction tạo sản phẩm + ảnh + SKU
  DbEngine <--> TblVouch : Thêm mã, kiểm tra %, đổi active
  DbEngine <--> TblUsers : Đổi active/locked (Chặn khóa Admin)
  DbEngine <--> TblBanners : Thêm, sửa, xóa banner quảng cáo
}

@enduml
