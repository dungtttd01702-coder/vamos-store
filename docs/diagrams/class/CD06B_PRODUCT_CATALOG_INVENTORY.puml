' BOTTOM ROW: DOMAIN ENTITIES (REFERENCE DATA MODEL - UC11 & UC12 SCOPE)
' ==============================================================================
package "Domain Entities (Reference Data Model — UC11 & UC12 Scope)" as pkg_domain #F0FDF4 {

    class "Category" as Category <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + name: NVARCHAR(100)
        + slug: NVARCHAR(120) <<UQ>>
        + description: NVARCHAR(MAX) [0..1]
        + is_active: BIT = 1
        + created_at: DATETIME2
    }

    class "Brand" as Brand <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + name: NVARCHAR(100)
        + slug: NVARCHAR(120) <<UQ>>
        + description: NVARCHAR(MAX) [0..1]
        + created_at: DATETIME2
    }

    class "Product" as Product <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + category_id: INT <<FK>>
        + brand_id: INT [0..1] <<FK>>
        --
        + product_code: NVARCHAR(50) <<UQ>>
        + name: NVARCHAR(200)
        + slug: NVARCHAR(255) <<UQ>>
        + description: NVARCHAR(MAX) [0..1]
        + gender_target: NVARCHAR(20) = 'UNISEX'
        + base_price: DECIMAL(12,0)
        + sale_price: DECIMAL(12,0) [0..1]
        + status: NVARCHAR(20) = 'active'
        + created_at: DATETIME2
        + updated_at: DATETIME2
    }

    class "ProductImage" as ProductImage <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + product_id: INT <<FK>>
        --
        + image_url: NVARCHAR(1000)
        + is_primary: BIT = 0
        + display_order: INT = 0
        .. Filtered Unique Index ..
        {unique filtered: product_id WHERE is_primary = 1}
    }

    class "ProductVariant" as ProductVariant <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + product_id: INT <<FK>>
        + size_id: INT <<FK>>
        + color_id: INT <<FK>>
        --
        + sku: NVARCHAR(100) <<UQ>>
        + stock_quantity: INT = 0
        + status: NVARCHAR(20) = 'active'
        + created_at: DATETIME2
        + updated_at: DATETIME2
        .. Composite Unique ..
        {unique(product_id, size_id, color_id)}
    }

    class "Size" as Size <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + size_name: NVARCHAR(20) <<UQ>>
        + display_order: INT = 0
    }

    class "Color" as Color <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + color_name: NVARCHAR(50) <<UQ>>
        + hex_code: NVARCHAR(10) [0..1]
    }

    class "InventoryTransaction" as InventoryTransaction <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + variant_id: INT <<FK>>
        + user_id: INT <<FK>>
        --
        + old_quantity: INT
        + new_quantity: INT
        + change_quantity: INT
        + reason: NVARCHAR(255)
        + created_at: DATETIME2
    }

    class "User" as User <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + full_name: NVARCHAR(100)
        + email: NVARCHAR(150) <<UQ>>
        + role: NVARCHAR(20) = 'CUSTOMER'
        + status: NVARCHAR(20) = 'active'
        .. Audit Operator Context ..
        {operator in UC-11: session.user.role = 'ADMIN'}
    }
}

