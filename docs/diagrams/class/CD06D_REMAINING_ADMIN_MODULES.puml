' ==============================================================================
' TOP ROW: PRESENTATION & ROUTING LAYER
' Sắp xếp 3 thành phần ngang hàng: requireAdmin (trái) - adminRoutes (giữa) - AdminController (phải)
' ==============================================================================
package "Presentation & Routing Layer (/admin)" as pkg_routing #EFF6FF {

    class "requireAdmin" as requireAdmin <<middleware function>> {
        -- Function: src/middlewares/auth.middleware.js:132-158 --
        + requireAdmin(req: Request, res: Response, next: NextFunction): Promise<void>
        .. Route Guard & DB Verification ..
        {verifies session.user.role === 'ADMIN'}
        {queries DB: SELECT status, role FROM users WHERE id = @id}
        {fail-open on DB transient error: calls next() [lines 153-157]}
    }

    class "adminRoutes" as adminRoutes <<router, partial view>> {
        -- Module: src/routes/admin.routes.js (Customer & Banner Scope) --
        + router.use(requireAdmin) [line 7]
        .. Customer Accounts Management Routes (lines 44-46) ..
        + GET /customers [adminController.getCustomers] [line 44]
        + GET /customers/:id [adminController.getCustomerDetail] [line 45]
        + POST /customers/:id/toggle-status [adminController.postToggleCustomerStatus] [line 46]
        .. Hero Banners Management Routes (lines 49-52) ..
        + GET /banners [adminController.getBanners] [line 49]
        + POST /banners/create [adminController.postCreateBanner] [line 50]
        + POST /banners/:id/toggle [adminController.postToggleBanner] [line 51]
        + POST /banners/:id/delete [adminController.postDeleteBanner] [line 52]
    }

    class "AdminController" as AdminController <<controller, partial view>> {
        -- File: src/controllers/admin.controller.js (Customer & Banner Methods) --
        .. Customer Accounts Management (Direct DB Queries) ..
        + getCustomers(req: Request, res: Response, next: NextFunction): Promise<void> [lines 893-923]
        + getCustomerDetail(req: Request, res: Response, next: NextFunction): Promise<void> [lines 928-953]
        + postToggleCustomerStatus(req: Request, res: Response, next: NextFunction): Promise<void> [lines 958-980]
        .. Hero Banners Management (Direct DB Queries) ..
        + getBanners(req: Request, res: Response, next: NextFunction): Promise<void> [lines 985-996]
        + postCreateBanner(req: Request, res: Response, next: NextFunction): Promise<void> [lines 1001-1020]
        + postToggleBanner(req: Request, res: Response, next: NextFunction): Promise<void> [lines 1025-1038]
        + postDeleteBanner(req: Request, res: Response, next: NextFunction): Promise<void> [lines 1040-1048]
    }
}

adminRoutes .left.> requireAdmin : "router.use(requireAdmin)\n[src/routes/admin.routes.js:7]"
adminRoutes .right.> AdminController : "dispatches 3 customer & 4 banner routes\n[src/routes/admin.routes.js:44-46, 49-52]"

' ==============================================================================
' MIDDLE ROW: DATA ACCESS & PERSISTENCE LAYER
' ==============================================================================
package "Data Access & Persistence Layer" as pkg_data #F8FAFC {

    class "database" as database <<database helper>> {
        -- CommonJS Module: src/config/database.js:1-117 --
        + sql: Object (mssql driver instance) [lines 1, 111]
        + getPool(): Promise<sql.ConnectionPool> [lines 11-32, 112]
        + closePool(): Promise<void> [lines 36-49, 113]
        + testDbConnection(): Promise<boolean> [lines 55-66, 114]
