' ==============================================================================
' BOTTOM ROW: DOMAIN ENTITIES (REFERENCE DATA MODEL - UC10 & UC14 SCOPE)
' ==============================================================================
package "Domain Entities (Reference Data Model — UC10 & UC14 Scope)" as pkg_domain #F0FDF4 {

    class "User" as User <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + full_name: NVARCHAR(100)
        + email: NVARCHAR(150) <<UQ>>
        + phone: NVARCHAR(20) [0..1]
        + role: NVARCHAR(20) = 'CUSTOMER'
        + status: NVARCHAR(20) = 'active'
    }

    class "Order" as Order <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + user_id: INT <<FK>>
        + voucher_id: INT [0..1] <<FK>>
        --
        + order_code: NVARCHAR(50) <<UQ>>
        + recipient_name_snapshot: NVARCHAR(100)
        + recipient_phone_snapshot: NVARCHAR(20)
        + delivery_address_snapshot: NVARCHAR(500)
        + subtotal: DECIMAL(12,0)
        + discount_amount: DECIMAL(12,0) = 0
        + shipping_fee: DECIMAL(12,0) = 0
        + total_amount: DECIMAL(12,0)
        + voucher_code_snapshot: NVARCHAR(50) [0..1]
        + payment_method: NVARCHAR(20) = 'COD'
        + payment_status: NVARCHAR(20) = 'UNPAID'
        + order_status: NVARCHAR(20) = 'PENDING'
        + customer_note: NVARCHAR(500) [0..1]
        + admin_note: NVARCHAR(500) [0..1]
        + created_at: DATETIME2
        + updated_at: DATETIME2
    }

    class "OrderItem" as OrderItem <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + order_id: INT <<FK>>
        + product_variant_id: INT <<FK>>
        --
        + product_name_snapshot: NVARCHAR(200)
        + sku_snapshot: NVARCHAR(100)
        + size_snapshot: NVARCHAR(20)
        + color_snapshot: NVARCHAR(50)
        + unit_price: DECIMAL(12,0)
        + quantity: INT
        + line_total: DECIMAL(12,0)
    }

    class "OrderStatusHistory" as OrderStatusHistory <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + order_id: INT <<FK>>
        + changed_by: INT <<FK>>
        --
        + previous_status: NVARCHAR(50) [0..1]
        + new_status: NVARCHAR(50)
        + note: NVARCHAR(255) [0..1]
        + created_at: DATETIME2
    }

    class "Product" as Product <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + product_code: NVARCHAR(50) <<UQ>>
        + name: NVARCHAR(200)
        + slug: NVARCHAR(255) <<UQ>>
        + base_price: DECIMAL(12,0)
        + sale_price: DECIMAL(12,0) [0..1]
        + status: NVARCHAR(20) = 'active'
    }

    class "ProductVariant" as ProductVariant <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + product_id: INT <<FK>>
        + size_id: INT <<FK>>
        + color_id: INT <<FK>>
        --
        + sku: NVARCHAR(100) <<UQ>>
        + stock_quantity: INT = 0
        + status: NVARCHAR(20) = 'active'
        .. Composite Unique ..
        {unique(product_id, size_id, color_id)}
    }

    class "ProductImage" as ProductImage <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + product_id: INT <<FK>>
        --
        + image_url: NVARCHAR(1000)
        + is_primary: BIT = 0
        + display_order: INT = 0
        .. Filtered Unique Index ..
        {unique filtered: product_id WHERE is_primary = 1}
    }

    class "InventoryTransaction" as InventoryTransaction <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + variant_id: INT <<FK>>
        + user_id: INT <<FK>>
        --
        + old_quantity: INT
        + new_quantity: INT
        + change_quantity: INT
        + reason: NVARCHAR(255)
        + created_at: DATETIME2
    }

    class "Voucher" as Voucher <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        --
        + code: NVARCHAR(50) <<UQ>>
        + discount_type: NVARCHAR(20)
        + discount_value: DECIMAL(12,0)
        + min_order_value: DECIMAL(12,0) = 0
        + max_discount_amount: DECIMAL(12,0) [0..1]
        + usage_limit: INT = 0
        + used_count: INT = 0
        + is_active: BIT = 1
        + start_date: DATETIME2
        + end_date: DATETIME2
    }

    class "VoucherUsage" as VoucherUsage <<entity, partial view from CD01>> {
        + id: INT <<PK>>
        + voucher_id: INT <<FK>>
        + user_id: INT <<FK>>
        + order_id: INT <<FK>>
        --
        + used_at: DATETIME2
        .. Composite Unique ..
        {unique(voucher_id, user_id)}
    }
}

