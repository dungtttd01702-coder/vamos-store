User "1" -- "0..*" OrderStatusHistory : "fk_order_histories_user\n(changed_by)"
User "1" -- "0..*" InventoryTransaction : "fk_inv_trans_user\n(operates)"
User "1" -- "0..*" VoucherUsage : "FK_voucher_usages_user\n(records)"

ProductVariant "1" -- "0..*" OrderItem : "fk_order_items_variant\n(ordered as)"
ProductVariant "1" -- "0..*" InventoryTransaction : "fk_inv_trans_variant\n(logs)"

Order "1" -- "0..*" VoucherUsage : "FK_voucher_usages_order\n(applies)"
Voucher "0..1" -- "0..*" Order : "fk_orders_voucher\n(applied to)"
Voucher "1" -- "0..*" VoucherUsage : "FK_voucher_usages_voucher\n(logs usage)"

