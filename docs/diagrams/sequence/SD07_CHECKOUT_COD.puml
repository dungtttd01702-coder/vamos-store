@startuml SD07_CHECKOUT_COD
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B
skinparam sequenceGroupBorderColor #64748B
skinparam sequenceGroupBackgroundColor #F8FAFC
autonumber "<b>[00]</b>"

title BIỂU ĐỒ TUẦN TỰ: ĐẶT HÀNG THANH TOÁN COD (SD07 - CHECKOUT COD TRANSACTION)\nHỆ THỐNG THƯƠNG MẠI ĐIỆN TỬ VAMOS STORE

actor "Khách hàng\n(Customer)" as Customer
participant "Trình duyệt Web\n(Browser / Client)" as Browser
participant "Checkout Router\n(checkout.routes.js)" as Router
participant "CSRF Middleware\n(csrf.middleware.js)" as CsrfMid
participant "Customer Guard\n(requireCustomer)" as AuthGuard
participant "Checkout Controller\n(checkout.controller.js)" as CheckCtrl
participant "Tiện ích Validate\n(validator.js)" as Validator
participant "Order Service\n(order.service.js)" as OrderService
participant "Database Pool & Tx\n(database.js)" as DbPool
database "Microsoft SQL Server\n(vamos_store_db)" as SqlDb

Customer -> Browser : Điền thông tin giao hàng, voucher & bấm "Đặt hàng ngay (COD)"
Browser -> Router : POST /checkout\n{ recipient_name, recipient_phone, delivery_address, voucher_code, customer_note, _csrf }
Router -> CsrfMid : Kiểm tra token _csrf
alt Token CSRF không hợp lệ
    CsrfMid --> Browser : HTTP 403 Forbidden
else Token hợp lệ
    CsrfMid -> AuthGuard : Kiểm tra phiên đăng nhập (Customer Role)
    alt Không phải Customer (Guest hoặc Admin)
        AuthGuard --> Browser : Chuyển hướng đăng nhập hoặc từ chối HTTP 403
    else Xác thực Customer thành công
        AuthGuard -> CheckCtrl : postCheckout(req, res, next)
        CheckCtrl -> Validator : isValidFullName(recipient_name), isValidPhone(recipient_phone)
        alt Tên hoặc SĐT không đúng định dạng
            Validator --> CheckCtrl : Lỗi xác thực
            CheckCtrl --> Browser : res.render('pages/checkout/index', { error_msg: "Thông tin nhận hàng không hợp lệ" })
        else Dữ liệu người nhận hợp lệ
            CheckCtrl -> OrderService : createCodOrder({\n  userId, recipientName, recipientPhone,\n  deliveryAddress, customerNote, voucherCode\n})
            
            OrderService -> DbPool : getPool() & new sql.Transaction(pool) & transaction.begin()
            DbPool -> SqlDb : BEGIN TRANSACTION (Bảo đảm nguyên tử ACID)
            
            OrderService -> DbPool : Khóa giỏ hàng CSDL: SELECT ci.*, pv.stock_quantity ...\nFROM carts ct WITH (UPDLOCK, ROWLOCK)\nJOIN cart_items ci WITH (UPDLOCK, HOLDLOCK) ON ci.cart_id = ct.id\nJOIN product_variants pv ON ci.variant_id = pv.id ...\nWHERE ct.user_id = @userId
            DbPool -> SqlDb : Thực thi truy vấn khóa bi quan giỏ hàng
            SqlDb --> DbPool : cartItems
            
            alt Giỏ hàng rỗng
                OrderService -> DbPool : transaction.rollback()
                DbPool -> SqlDb : ROLLBACK TRANSACTION
                OrderService --> CheckCtrl : Ném ngoại lệ: "Giỏ hàng rỗng"
                CheckCtrl --> Browser : res.redirect('/cart')
            else Giỏ hàng có sản phẩm
                OrderService -> OrderService : Tính subtotal = SUM(unit_price * quantity)\nTính phí vận chuyển: shippingFee = subtotal >= 500000 ? 0 : 30000
                
                opt Khách hàng có nhập mã Voucher (voucherCode != null)
                    OrderService -> DbPool : Khóa voucher: SELECT * FROM vouchers WITH (UPDLOCK, ROWLOCK)\nWHERE code = @code AND is_active = 1\nAND start_date <= GETDATE() AND end_date >= GETDATE()
                    DbPool -> SqlDb : Thực thi kiểm tra voucher
                    SqlDb --> DbPool : voucherRecord
                    
                    OrderService -> OrderService : Kiểm tra min_order_value, usage_limit
                    OrderService -> DbPool : Kiểm tra quy tắc 1 lần/khách (Q8):\nSELECT 1 FROM voucher_usages WITH (UPDLOCK, ROWLOCK)\nWHERE voucher_id = @vId AND user_id = @userId
                    DbPool -> SqlDb : Thực thi đối soát bảng voucher_usages
                    SqlDb --> DbPool : usageRecord
                    
                    alt Voucher không hợp lệ hoặc khách hàng đã từng sử dụng
                        OrderService -> DbPool : transaction.rollback()
                        DbPool -> SqlDb : ROLLBACK TRANSACTION
                        OrderService --> CheckCtrl : Ném ngoại lệ lỗi voucher
                        CheckCtrl --> Browser : res.render('pages/checkout/index', { error_msg: "Mã giảm giá không hợp lệ hoặc đã dùng" })
                    else Voucher thỏa mãn điều kiện
                        OrderService -> OrderService : Tính discountAmount theo % hoặc số tiền cố định\nTính totalAmount = subtotal - discountAmount + shippingFee
                        OrderService -> DbPool : UPDATE vouchers SET used_count = used_count + 1\nWHERE id = @vId AND (usage_limit = 0 OR used_count < usage_limit)
                        DbPool -> SqlDb : Cập nhật số lượt dùng voucher nguyên tử
                    end
                end
                
                OrderService -> OrderService : Sinh mã đơn hàng dạng VAMYYMMDD-XXXX (Thử tối đa 5 lần chống trùng lặp)
                
                loop Duyệt qua từng món hàng trong giỏ (for each cart item)
                    OrderService -> DbPool : Khóa biến thể kho:\nSELECT id, stock_quantity, sku FROM product_variants WITH (UPDLOCK, ROWLOCK)\nWHERE id = @varId
                    DbPool -> SqlDb : Thực thi khóa dòng biến thể
                    SqlDb --> DbPool : currentStock
                    
                    alt Tồn kho không đủ (currentStock < item.quantity)
                        OrderService -> DbPool : transaction.rollback()
                        DbPool -> SqlDb : ROLLBACK TRANSACTION
                        OrderService --> CheckCtrl : Ném ngoại lệ hết hàng tồn
                        CheckCtrl --> Browser : res.render('pages/checkout/index', { error_msg: "Sản phẩm vừa hết hàng tồn kho" })
                    else Tồn kho khả dụng
                        OrderService -> DbPool : UPDATE product_variants SET stock_quantity = stock_quantity - @qty, updated_at = GETDATE() WHERE id = @varId
                        DbPool -> SqlDb : Trừ tồn kho biến thể
                        
                        OrderService -> DbPool : INSERT INTO inventory_transactions\n(variant_id, user_id, old_quantity, new_quantity, change_quantity = -qty, reason='Xuất kho tạo đơn hàng #...')
                        DbPool -> SqlDb : Ghi nhật ký biến động kho (Audit Trail)
                    end
                end
                
                OrderService -> DbPool : INSERT INTO orders (order_code, user_id, recipient_name_snapshot, recipient_phone_snapshot,\ndelivery_address_snapshot, subtotal, discount_amount, shipping_fee, total_amount,\nvoucher_id, voucher_code_snapshot, payment_method='COD', payment_status='UNPAID',\norder_status='PENDING', customer_note)\nOUTPUT INSERTED.id, INSERTED.order_code
                DbPool -> SqlDb : Tạo đơn hàng chính trong bảng orders
                SqlDb --> DbPool : Trả về orderId vừa tạo
                
                opt Đơn hàng có áp dụng Voucher
                    OrderService -> DbPool : INSERT INTO voucher_usages (voucher_id, user_id, order_id, used_at)
                    DbPool -> SqlDb : Ghi nhận lịch sử dùng voucher (Bảo vệ bởi UNIQUE (voucher_id, user_id))
                    alt Xảy ra xung đột tranh chấp (Duplicate Key Exception trên UQ_voucher_user_usage)
                        SqlDb --> DbPool : Ném lỗi Vi phạm ràng buộc duy nhất (Unique Constraint Violation)
                        DbPool --> OrderService : Ném ngoại lệ SQL duplicate key
                        OrderService -> DbPool : transaction.rollback()
                        DbPool -> SqlDb : ROLLBACK TRANSACTION
                        OrderService --> CheckCtrl : Báo lỗi voucher đã bị tài khoản sử dụng đồng thời
                        CheckCtrl --> Browser : res.render('pages/checkout/index', { error_msg: "Mã giảm giá đã được sử dụng" })
                    else Ghi nhận voucher thành công
                        SqlDb --> DbPool : Xác nhận ghi voucher_usages
                    end
                end
                
                OrderService -> DbPool : Lặp ghi INSERT INTO order_items (order_id, product_variant_id,\nproduct_name_snapshot, sku_snapshot, size_snapshot, color_snapshot, unit_price, quantity, line_total)
                DbPool -> SqlDb : Lưu snapshot chi tiết các món vào order_items (Khóa ngoại: product_variant_id)
                
                OrderService -> DbPool : INSERT INTO order_status_histories (order_id, changed_by, previous_status=NULL, new_status='PENDING', note='Khách hàng đặt hàng COD thành công qua website.')
                DbPool -> SqlDb : Ghi nhận trạng thái ban đầu của đơn
                
                OrderService -> DbPool : DELETE FROM cart_items WHERE cart_id = @cartId
                DbPool -> SqlDb : Xóa sạch các món trong giỏ hàng CSDL
                
                OrderService -> DbPool : transaction.commit()
                DbPool -> SqlDb : COMMIT TRANSACTION (Xác nhận vĩnh viễn mọi thay đổi)
                
                OrderService --> CheckCtrl : Trả về đối tượng order { id, orderCode, totalAmount }
                CheckCtrl -> CheckCtrl : req.session.cartCount = 0 (Làm rỗng badge giỏ hàng)
                CheckCtrl --> Browser : HTTP 302 Redirect về '/checkout/success/:id'
                Browser --> Customer : Hiển thị màn hình đặt hàng COD thành công với mã đơn hàng
            end
        end
    end
end

@enduml