@startuml SD12_CATALOG_MANAGEMENT
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B
skinparam sequenceGroupBorderColor #64748B
skinparam sequenceGroupBackgroundColor #F8FAFC
autonumber "<b>[00]</b>"

title BIỂU ĐỒ TUẦN TỰ: QUẢN LÝ SẢN PHẨM & DANH MỤC (SD12 - CATALOG MANAGEMENT)\nHỆ THỐNG THƯƠNG MẠI ĐIỆN TỬ VAMOS STORE

actor "Quản trị viên\n(Admin)" as Admin
participant "Trình duyệt Quản trị\n(Admin Browser)" as Browser
participant "Admin Router\n(admin.routes.js)" as Router
participant "Admin Guard\n(requireAdmin)" as AuthGuard
participant "CSRF Middleware\n(csrf.middleware.js)" as CsrfMid
participant "Admin Controller\n(admin.controller.js)" as AdminCtrl
participant "Database Pool & Tx\n(database.js)" as DbPool
database "Microsoft SQL Server\n(vamos_store_db)" as SqlDb

== LUỒNG 1: THÊM MỚI SẢN PHẨM KÈM ẢNH & BIẾN THỂ BAN ĐẦU (CREATE PRODUCT) ==

Admin -> Browser : Điền tên, mã SP, danh mục, giá gốc, giá sale, ảnh & biến thể (Size/Màu/Tồn kho)\n& bấm "Lưu sản phẩm"
Browser -> Router : POST /admin/products/create\n{ name, product_code, category_id, brand_id, base_price, sale_price, image_url, size_id, color_id, stock_quantity, _csrf }
Router -> AuthGuard : requireAdmin
AuthGuard -> CsrfMid : Kiểm tra token _csrf
CsrfMid -> AdminCtrl : postCreateProduct(req, res, next)

alt Thiếu thông tin bắt buộc (Tên, Mã SP, Danh mục, Giá)
    AdminCtrl --> Browser : Báo lỗi: "Vui lòng điền đầy đủ thông tin bắt buộc"
else Thông tin hợp lệ
    AdminCtrl -> AdminCtrl : Tạo chuỗi slug duy nhất từ tên sản phẩm
    AdminCtrl -> DbPool : getPool() & new sql.Transaction(pool) & transaction.begin()
    DbPool -> SqlDb : BEGIN TRANSACTION
    
    AdminCtrl -> DbPool : INSERT INTO products (name, slug, product_code, category_id, brand_id, gender_target, base_price, sale_price, description, status='active')\nOUTPUT INSERTED.id
    DbPool -> SqlDb : Thêm sản phẩm vào bảng products
    SqlDb --> DbPool : Trả về newProductId
    
    opt Có đường dẫn ảnh đại diện (image_url)
        AdminCtrl -> DbPool : INSERT INTO product_images (product_id, image_url, is_primary=1, display_order=1)
        DbPool -> SqlDb : Thêm ảnh đại diện chính vào bảng product_images
    end
    
    opt Có kích cỡ và màu sắc ban đầu (size_id, color_id)
        AdminCtrl -> AdminCtrl : Tự động sinh mã SKU chuẩn: PRODUCTCODE-SIZE-COLOR
        AdminCtrl -> DbPool : INSERT INTO product_variants (product_id, size_id, color_id, sku, stock_quantity, status='active')
        DbPool -> SqlDb : Thêm biến thể đầu tiên vào bảng product_variants
    end
    
    AdminCtrl -> DbPool : transaction.commit()
    DbPool -> SqlDb : COMMIT TRANSACTION
    
    AdminCtrl --> Browser : HTTP 302 Redirect về '/admin/products'
    Browser --> Admin : Hiển thị bảng danh sách sản phẩm với sản phẩm mới vừa tạo
end

== LUỒNG 2: BẬT / TẮT TRẠNG THÁI KINH DOANH SẢN PHẨM (TOGGLE STATUS) ==

Admin -> Browser : Nhấp vào nút "Khóa / Mở bán" một sản phẩm
Browser -> Router : POST /admin/products/:id/toggle\n{ _csrf }
Router -> AuthGuard : requireAdmin
AuthGuard -> CsrfMid : Kiểm tra token _csrf
CsrfMid -> AdminCtrl : postToggleProductStatus(req, res, next)

AdminCtrl -> DbPool : query("UPDATE products SET status = CASE WHEN status = 'active' THEN 'inactive' ELSE 'active' END, updated_at = GETDATE() WHERE id = @id", { id })
DbPool -> SqlDb : Chuyển đổi trạng thái sản phẩm giữa active và inactive
SqlDb --> DbPool : Xác nhận cập nhật
AdminCtrl --> Browser : HTTP 302 Redirect về '/admin/products'
Browser --> Admin : Tải lại danh sách, nhãn trạng thái đổi sang Đang bán hoặc Tạm dừng

== LUỒNG 3: THÊM MỚI DANH MỤC SẢN PHẨM (CREATE CATEGORY) ==

Admin -> Browser : Nhập tên danh mục, mô tả & bấm "Tạo danh mục"
Browser -> Router : POST /admin/categories/create\n{ name, description, _csrf }
Router -> AuthGuard : requireAdmin
AuthGuard -> CsrfMid : Kiểm tra token _csrf
CsrfMid -> AdminCtrl : postCreateCategory(req, res, next)

AdminCtrl -> AdminCtrl : Tạo category slug (ví dụ: "giay-sneaker")
AdminCtrl -> DbPool : query("INSERT INTO categories (name, slug, description, is_active) VALUES (@name, @slug, @desc, 1)")
DbPool -> SqlDb : Thêm danh mục mới vào bảng categories
SqlDb --> DbPool : Xác nhận thêm mới
AdminCtrl --> Browser : HTTP 302 Redirect về '/admin/categories'
Browser --> Admin : Hiển thị danh mục mới trên bảng quản trị

@enduml
