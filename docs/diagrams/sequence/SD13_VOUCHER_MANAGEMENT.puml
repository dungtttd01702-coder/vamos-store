@startuml SD13_VOUCHER_MANAGEMENT
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B
skinparam sequenceGroupBorderColor #64748B
skinparam sequenceGroupBackgroundColor #F8FAFC
autonumber "<b>[00]</b>"

title BIỂU ĐỒ TUẦN TỰ: QUẢN LÝ MÃ GIẢM GIÁ (SD13 - VOUCHER MANAGEMENT)\nHỆ THỐNG THƯƠNG MẠI ĐIỆN TỬ VAMOS STORE

actor "Quản trị viên\n(Admin)" as Admin
participant "Trình duyệt Quản trị\n(Admin Browser)" as Browser
participant "Admin Router\n(admin.routes.js)" as Router
participant "Admin Guard\n(requireAdmin)" as AuthGuard
participant "CSRF Middleware\n(csrf.middleware.js)" as CsrfMid
participant "Admin Controller\n(admin.controller.js)" as AdminCtrl
participant "Database Pool\n(database.js)" as DbPool
database "Microsoft SQL Server\n(vamos_store_db)" as SqlDb

== LUỒNG 1: TẠO MỚI MÃ GIẢM GIÁ (CREATE VOUCHER) ==

Admin -> Browser : Nhập mã CODE, loại chiết khấu (% / số tiền), giá trị, đơn tối thiểu, giới hạn lượt dùng, ngày áp dụng & bấm "Tạo Voucher"
Browser -> Router : POST /admin/vouchers/create\n{ code, name, discount_type, discount_value, min_order_value, max_discount_amount, usage_limit, start_date, end_date, _csrf }
Router -> AuthGuard : requireAdmin
AuthGuard -> CsrfMid : Kiểm tra token _csrf
CsrfMid -> AdminCtrl : postCreateVoucher(req, res, next)

alt Mã CODE rỗng hoặc discount_value <= 0
    AdminCtrl --> Browser : Báo lỗi: "Mã giảm giá và giá trị chiết khấu là bắt buộc và phải lớn hơn 0"
else Loại chiết khấu là percentage và discount_value > 100
    AdminCtrl --> Browser : Báo lỗi: "Chiết khấu phần trăm không được vượt quá 100%"
else Dữ liệu hợp lệ
    AdminCtrl -> AdminCtrl : Chuẩn hóa mã: code.trim().toUpperCase()
    AdminCtrl -> DbPool : query("SELECT id FROM vouchers WHERE code = @code", { code })
    DbPool -> SqlDb : Kiểm tra mã giảm giá trùng lặp
    SqlDb --> DbPool : existRes
    
    alt Mã voucher đã tồn tại trong hệ thống
        AdminCtrl --> Browser : Báo lỗi: "Mã giảm giá này đã tồn tại, vui lòng chọn mã khác"
    else Mã voucher duy nhất
        AdminCtrl -> DbPool : query("INSERT INTO vouchers (code, name, discount_type, discount_value, min_order_value, max_discount_amount, usage_limit, used_count, start_date, end_date, is_active) VALUES (@code, @name, @type, @val, @minOrder, @maxDisc, @limit, 0, @start, @end, 1)")
        DbPool -> SqlDb : Thêm mới vào bảng vouchers
        SqlDb --> DbPool : Xác nhận thêm mới
        AdminCtrl --> Browser : HTTP 302 Redirect về '/admin/vouchers'
        Browser --> Admin : Hiển thị bảng danh sách voucher kèm mã mới tạo
    end
end

== LUỒNG 2: BẬT / TẮT KÍCH HOẠT VOUCHER (TOGGLE VOUCHER STATUS) ==

Admin -> Browser : Nhấp vào nút "Kích hoạt / Tạm dừng" một mã voucher
Browser -> Router : POST /admin/vouchers/:id/toggle\n{ _csrf }
Router -> AuthGuard : requireAdmin
AuthGuard -> CsrfMid : Kiểm tra token _csrf
CsrfMid -> AdminCtrl : postToggleVoucherStatus(req, res, next)

AdminCtrl -> DbPool : query("UPDATE vouchers SET is_active = CASE WHEN is_active = 1 THEN 0 ELSE 1 END, updated_at = GETDATE() WHERE id = @id", { id })
DbPool -> SqlDb : Đảo bit trạng thái is_active giữa 1 và 0
SqlDb --> DbPool : Xác nhận cập nhật
AdminCtrl --> Browser : HTTP 302 Redirect về '/admin/vouchers'
Browser --> Admin : Tải lại trang, nhãn trạng thái đổi sang Đang áp dụng hoặc Tạm khóa

== LUỒNG 3: XEM DANH SÁCH & THEO DÕI LƯỢT DÙNG VOUCHER ==

Admin -> Browser : Nhấp vào tab "Mã giảm giá"
Browser -> Router : GET /admin/vouchers
Router -> AuthGuard : requireAdmin
AuthGuard -> AdminCtrl : getVouchers(req, res, next)
AdminCtrl -> DbPool : query("SELECT v.*, (SELECT COUNT(*) FROM voucher_usages WHERE voucher_id = v.id) as actual_usages FROM vouchers v ORDER BY v.id DESC")
DbPool -> SqlDb : Truy vấn danh sách voucher kèm số lượt đã dùng thực tế
SqlDb --> DbPool : Trả về recordset vouchers
DbPool --> AdminCtrl : vouchersList
AdminCtrl --> Browser : res.render('pages/admin/vouchers', { vouchers: vouchersList })
Browser --> Admin : Hiển thị bảng chi tiết các voucher, hạn sử dụng và tiến trình sử dụng (used_count / usage_limit)

@enduml
