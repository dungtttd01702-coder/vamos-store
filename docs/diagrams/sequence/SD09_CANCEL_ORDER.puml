@startuml SD09_CANCEL_ORDER
!theme plain
skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundcorner 6
skinparam ArrowColor #1E293B
skinparam sequenceGroupBorderColor #64748B
skinparam sequenceGroupBackgroundColor #F8FAFC
autonumber "<b>[00]</b>"

title BIỂU ĐỒ TUẦN TỰ: HỦY ĐƠN HÀNG PHÍA KHÁCH HÀNG (SD09 - CANCEL ORDER)\nHỆ THỐNG THƯƠNG MẠI ĐIỆN TỬ VAMOS STORE

actor "Khách hàng\n(Customer)" as Customer
participant "Trình duyệt Web\n(Browser / Client)" as Browser
participant "Account Router\n(account.routes.js)" as Router
participant "Customer Guard\n(requireCustomer)" as AuthGuard
participant "CSRF Middleware\n(csrf.middleware.js)" as CsrfMid
participant "Account Controller\n(account.controller.js)" as AccCtrl
participant "Order Service\n(order.service.js)" as OrderService
participant "Database Pool & Tx\n(database.js)" as DbPool
database "Microsoft SQL Server\n(vamos_store_db)" as SqlDb

Customer -> Browser : Nhấp "Hủy đơn hàng", nhập lý do & xác nhận
Browser -> Router : POST /account/orders/:id/cancel\n{ reason, _csrf }
Router -> AuthGuard : requireCustomer
AuthGuard -> CsrfMid : Kiểm tra token _csrf
CsrfMid -> AccCtrl : postCancelOrder(req, res, next)

AccCtrl -> OrderService : cancelOrder(orderId, userId, reason)
OrderService -> DbPool : getPool() & new sql.Transaction(pool) & transaction.begin()
DbPool -> SqlDb : BEGIN TRANSACTION (Bảo vệ giao dịch hoàn kho ACID)

OrderService -> DbPool : Khóa đơn hàng CSDL:\nSELECT id, order_code, order_status, payment_status\nFROM orders WITH (UPDLOCK, ROWLOCK)\nWHERE id = @orderId AND user_id = @userId
DbPool -> SqlDb : Thực thi truy vấn khóa bi quan
SqlDb --> DbPool : orderRecord

alt Đơn hàng không tồn tại hoặc không thuộc quyền sở hữu của Customer
    OrderService -> DbPool : transaction.rollback()
    DbPool -> SqlDb : ROLLBACK TRANSACTION
    OrderService --> AccCtrl : Ném ngoại lệ: "Không tìm thấy đơn hàng hoặc không có quyền"
    AccCtrl --> Browser : Báo lỗi không có quyền hủy đơn
else Đơn hàng thuộc sở hữu của Customer
    alt Đơn hàng đã ở trạng thái ĐÃ HỦY (order_status === 'CANCELLED')
        OrderService -> DbPool : transaction.rollback()
        DbPool -> SqlDb : ROLLBACK TRANSACTION
        OrderService --> AccCtrl : Ném ngoại lệ chống hoàn kho kép (Anti Double Restitution)
        AccCtrl --> Browser : Báo lỗi: "Đơn hàng đã được hủy trước đó"
    else Trạng thái khác 'PENDING' (CONFIRMED, PROCESSING, SHIPPING, COMPLETED)
        OrderService -> DbPool : transaction.rollback()
        DbPool -> SqlDb : ROLLBACK TRANSACTION
        OrderService --> AccCtrl : Ném ngoại lệ ràng buộc trạng thái: "Chỉ được hủy khi đơn đang PENDING"
        AccCtrl --> Browser : Báo lỗi: "Đơn hàng đã được xử lý/giao, không thể tự hủy"
    else Đơn hàng hợp lệ và đang ở trạng thái 'PENDING'
        OrderService -> DbPool : SELECT product_variant_id, quantity, product_name_snapshot\nFROM order_items WHERE order_id = @orderId
        DbPool -> SqlDb : Lấy danh sách các món trong đơn hàng (Khóa ngoại: product_variant_id)
        SqlDb --> DbPool : itemsList
        
        loop Duyệt từng món hàng trong đơn (Hoàn trả tồn kho tự động)
            OrderService -> DbPool : Khóa biến thể: SELECT stock_quantity FROM product_variants WITH (UPDLOCK, ROWLOCK) WHERE id = @varId
            DbPool -> SqlDb : Khóa dòng biến thể
            SqlDb --> DbPool : currentStock
            
            OrderService -> DbPool : UPDATE product_variants SET stock_quantity = @newStock, updated_at = GETDATE() WHERE id = @varId
            DbPool -> SqlDb : Cộng hoàn trả số lượng vào tồn kho (newStock = currentStock + quantity)
            
            OrderService -> DbPool : INSERT INTO inventory_transactions (variant_id, user_id, old_quantity, new_quantity, change_quantity = +qty, reason)\nVALUES (@varId, @userId, @oldStock, @newStock, @qty, @reason)
            DbPool -> SqlDb : Ghi nhật ký hoàn kho với số lượng dương (+qty)
        end
        
        OrderService -> DbPool : UPDATE orders SET order_status = 'CANCELLED', updated_at = GETDATE() WHERE id = @orderId
        DbPool -> SqlDb : Đổi trạng thái đơn sang CANCELLED
        
        opt Đơn hàng có sử dụng Voucher (appliedVoucherId != null)
            OrderService -> DbPool : DELETE FROM voucher_usages WHERE order_id = @orderId
            DbPool -> SqlDb : Xóa bản ghi lịch sử dùng voucher của khách
            
            OrderService -> DbPool : UPDATE vouchers SET used_count = CASE WHEN used_count > 0 THEN used_count - 1 ELSE 0 END WHERE id = @vouchId
            DbPool -> SqlDb : Trả lại 1 lượt dùng cho mã giảm giá (giải phóng voucher)
        end
        
        OrderService -> DbPool : INSERT INTO order_status_histories (order_id, changed_by, previous_status='PENDING', new_status='CANCELLED', note)\nVALUES (@orderId, @userId, 'PENDING', 'CANCELLED', @note)
        DbPool -> SqlDb : Ghi nhận lịch sử hủy đơn
        
        OrderService -> DbPool : transaction.commit()
        DbPool -> SqlDb : COMMIT TRANSACTION (Xác nhận hoàn kho và hủy đơn vĩnh viễn)
        
        OrderService --> AccCtrl : Hoàn tất hủy đơn { success: true, orderId, orderCode, status: 'CANCELLED' }
        AccCtrl --> Browser : HTTP 302 Redirect về '/account/orders/:id?cancelled=true'
        Browser --> Customer : Tải lại trang chi tiết đơn với trạng thái ĐÃ HỦY và thông báo thành công
    end
end

@enduml