@startuml vamos_store_erd
title SƠ ĐỒ MỐI QUAN HỆ THỰC THỂ (ERD) - VAMOS STORE (MySQL 8)
caption Phiên bản v1.2 Chuẩn hóa • 18 Thực thể • Phân nhóm 6 Phân hệ Nghiệp vụ

skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 11
skinparam packageFontSize 12
skinparam packageFontStyle bold
skinparam packageTitleAlignment center

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
    HeaderBackgroundColor #F1F5F9
    BorderThickness 1.2
    ArrowColor #2563EB
    ArrowThickness 1.2
}

' ========================================================
' 1. NHÓM NGƯỜI DÙNG & BẢO MẬT (USERS & AUTH)
' ========================================================
package "1. Người Dùng & Xác Thực (Users & Auth)" #EEF2FF {
  entity "users" as users #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * full_name : VARCHAR(100)
      * email : VARCHAR(150) <<UNIQUE>>
      * password_hash : VARCHAR(255)
      phone : VARCHAR(20)
      * role : ENUM('ADMIN','CUSTOMER') <<DEFAULT 'CUSTOMER'>>
      * status : ENUM('active','locked') <<DEFAULT 'active'>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
      updated_at : TIMESTAMP <<DEFAULT NOW ON UPDATE NOW>>
  }

  entity "addresses" as addresses #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * user_id : INT <<FK>>
      * recipient_name : VARCHAR(100)
      * phone : VARCHAR(20)
      * province : VARCHAR(100)
      * district : VARCHAR(100)
      * ward : VARCHAR(100)
      * detail_address : VARCHAR(255)
      is_default : BOOLEAN <<DEFAULT FALSE>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
      updated_at : TIMESTAMP <<DEFAULT NOW ON UPDATE NOW>>
  }

  entity "password_reset_tokens" as password_reset_tokens #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * user_id : INT <<FK>>
      * token : VARCHAR(255) <<UNIQUE>>
      * expires_at : DATETIME
      used_at : DATETIME
      created_at : TIMESTAMP <<DEFAULT NOW>>
  }
}

' ========================================================
' 2. NHÓM DANH MỤC, THƯƠNG HIỆU & SẢN PHẨM (CATALOG)
' ========================================================
package "2. Danh Mục & Sản Phẩm (Catalog & Brands)" #ECFDF5 {
  entity "categories" as categories #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * name : VARCHAR(100)
      * slug : VARCHAR(120) <<UNIQUE>>
      description : TEXT
      is_active : BOOLEAN <<DEFAULT TRUE>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
  }

  entity "brands" as brands #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * name : VARCHAR(100)
      * slug : VARCHAR(120) <<UNIQUE>>
      description : TEXT
      created_at : TIMESTAMP <<DEFAULT NOW>>
  }

  entity "products" as products #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * category_id : INT <<FK>>
      brand_id : INT <<FK>>
      * product_code : VARCHAR(50) <<UNIQUE>>
      * name : VARCHAR(200)
      * slug : VARCHAR(255) <<UNIQUE>>
      description : TEXT
      * gender_target : ENUM('MEN','WOMEN','KIDS','UNISEX') <<DEFAULT 'UNISEX'>>
      * base_price : DECIMAL(12,0) <<CHECK >= 0>>
      sale_price : DECIMAL(12,0) <<CHECK NULL OR (>=0 AND <base_price)>>
      * status : ENUM('active','inactive','draft') <<DEFAULT 'active'>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
      updated_at : TIMESTAMP <<DEFAULT NOW ON UPDATE NOW>>
  }

  entity "product_images" as product_images #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * product_id : INT <<FK>>
      * image_url : VARCHAR(255)
      is_primary : BOOLEAN <<DEFAULT FALSE>>
      display_order : INT <<DEFAULT 0>>
  }
}

' ========================================================
' 3. NHÓM BIẾN THỂ & THUỘC TÍNH (VARIANTS & INVENTORY)
' ========================================================
package "3. Biến Thể & Kho Hàng (Variants & Stock)" #FEF3C7 {
  entity "sizes" as sizes #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * size_name : VARCHAR(20) <<UNIQUE>>
      display_order : INT <<DEFAULT 0>>
  }

  entity "colors" as colors #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * color_name : VARCHAR(50) <<UNIQUE>>
      hex_code : VARCHAR(10)
  }

  entity "product_variants" as product_variants #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * product_id : INT <<FK>>
      * size_id : INT <<FK>>
      * color_id : INT <<FK>>
      * sku : VARCHAR(100) <<UNIQUE>>
      * stock_quantity : INT <<DEFAULT 0, CHECK >= 0>>
      * status : ENUM('active','inactive') <<DEFAULT 'active'>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
      updated_at : TIMESTAMP <<DEFAULT NOW ON UPDATE NOW>>
      .. Ràng buộc tổ hợp ..
      <<UNIQUE(product_id, size_id, color_id)>>
  }

  entity "inventory_transactions" as inventory_transactions #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * variant_id : INT <<FK>>
      * user_id : INT <<FK>>
      * old_quantity : INT <<CHECK >= 0>>
      * new_quantity : INT <<CHECK >= 0>>
      * change_quantity : INT
      * reason : VARCHAR(255)
      created_at : TIMESTAMP <<DEFAULT NOW>>
  }
}

' ========================================================
' 4. NHÓM GIỎ HÀNG (SHOPPING CART)
' ========================================================
package "4. Giỏ Hàng (Shopping Cart)" #F0FDF4 {
  entity "carts" as carts #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * user_id : INT <<FK, UNIQUE>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
      updated_at : TIMESTAMP <<DEFAULT NOW ON UPDATE NOW>>
  }

  entity "cart_items" as cart_items #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * cart_id : INT <<FK>>
      * variant_id : INT <<FK>>
      * quantity : INT <<DEFAULT 1, CHECK > 0>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
      updated_at : TIMESTAMP <<DEFAULT NOW ON UPDATE NOW>>
      .. Ràng buộc tổ hợp ..
      <<UNIQUE(cart_id, variant_id)>>
  }
}

' ========================================================
' 5. NHÓM KHUYẾN MÃI & QUẢNG BÁ (PROMOTION & MARKETING)
' ========================================================
package "5. Khuyến Mãi & Tiếp Thị (Promotion & Marketing)" #FDF2F8 {
  entity "vouchers" as vouchers #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * code : VARCHAR(50) <<UNIQUE>>
      * name : VARCHAR(100)
      * discount_type : ENUM('percentage','fixed_amount')
      * discount_value : DECIMAL(12,0) <<CHECK > 0>>
      * min_order_value : DECIMAL(12,0) <<DEFAULT 0, CHECK >= 0>>
      max_discount_amount : DECIMAL(12,0)
      * start_date : DATETIME
      * end_date : DATETIME <<CHECK end_date >= start_date>>
      * usage_limit : INT <<DEFAULT 0, CHECK >= 0>>
      * used_count : INT <<DEFAULT 0, CHECK used_count <= usage_limit>>
      * is_active : BOOLEAN <<DEFAULT TRUE>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
  }

  entity "banners" as banners #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * title : VARCHAR(150)
      * image_url : VARCHAR(255)
      link_url : VARCHAR(255)
      display_order : INT <<DEFAULT 0>>
      is_active : BOOLEAN <<DEFAULT TRUE>>
      created_at : TIMESTAMP <<DEFAULT NOW>>
  }
}

' ========================================================
' 6. NHÓM ĐƠN HÀNG & LỊCH SỬ (ORDERS & FULFILLMENT)
' ========================================================
package "6. Đơn Hàng & Vận Hành (Orders & Fulfillment)" #EFF6FF {
  entity "orders" as orders #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * order_code : VARCHAR(50) <<UNIQUE>>
      * user_id : INT <<FK>>
      * recipient_name_snapshot : VARCHAR(100)
      * recipient_phone_snapshot : VARCHAR(20)
      * delivery_address_snapshot : VARCHAR(500)
      * subtotal : DECIMAL(12,0) <<CHECK >= 0>>
      * discount_amount : DECIMAL(12,0) <<DEFAULT 0, CHECK >= 0>>
      * shipping_fee : DECIMAL(12,0) <<DEFAULT 0, CHECK >= 0>>
      * total_amount : DECIMAL(12,0) <<CHECK >= 0>>
      voucher_id : INT <<FK>>
      voucher_code_snapshot : VARCHAR(50)
      * payment_method : VARCHAR(20) <<DEFAULT 'COD'>>
      * payment_status : ENUM('UNPAID','PAID') <<DEFAULT 'UNPAID'>>
      * order_status : ENUM('PENDING','CONFIRMED','PROCESSING','SHIPPING','COMPLETED','CANCELLED') <<DEFAULT 'PENDING'>>
      customer_note : VARCHAR(255)
      admin_note : VARCHAR(255)
      created_at : TIMESTAMP <<DEFAULT NOW>>
      updated_at : TIMESTAMP <<DEFAULT NOW ON UPDATE NOW>>
  }

  entity "order_items" as order_items #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * order_id : INT <<FK>>
      * product_variant_id : INT <<FK>>
      * product_name_snapshot : VARCHAR(200)
      * sku_snapshot : VARCHAR(100)
      * size_snapshot : VARCHAR(20)
      * color_snapshot : VARCHAR(50)
      * unit_price : DECIMAL(12,0) <<CHECK >= 0>>
      * quantity : INT <<CHECK > 0>>
      * line_total : DECIMAL(12,0) <<CHECK >= 0>>
      .. Ràng buộc tổ hợp ..
      <<UNIQUE(order_id, product_variant_id)>>
  }

  entity "order_status_histories" as order_status_histories #F8FAFC {
      * id : INT <<PK, AI>>
      --
      * order_id : INT <<FK>>
      * changed_by : INT <<FK>>
      previous_status : VARCHAR(50)
      * new_status : VARCHAR(50)
      note : VARCHAR(255)
      created_at : TIMESTAMP <<DEFAULT NOW>>
  }
}

' ========================================================
' QUAN HỆ DỮ LIỆU & RÀNG BUỘC CARDINALITY
' ========================================================
users ||--o{ addresses : "1..N"
users ||--o| carts : "1..1"
users ||--o{ orders : "1..N"
users ||--o{ password_reset_tokens : "1..N"
users ||--o{ order_status_histories : "1..N"
users ||--o{ inventory_transactions : "1..N"

categories ||--o{ products : "1..N"
brands |o--o{ products : "0..1..N"
products ||--o{ product_images : "1..N"
products ||--|{ product_variants : "1..1..N"

sizes ||--o{ product_variants : "1..N"
colors ||--o{ product_variants : "1..N"

product_variants ||--o{ inventory_transactions : "1..N"
product_variants ||--o{ cart_items : "1..N"
product_variants ||--o{ order_items : "1..N"

carts ||--o{ cart_items : "1..N"

orders ||--|{ order_items : "1..1..N"
orders ||--|{ order_status_histories : "1..1..N"
vouchers |o--o{ orders : "0..1..N"

@enduml
