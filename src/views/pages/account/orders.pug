extends ../../layouts/main

block content
  //- ── BREADCRUMB NAVIGATION ──
  section.w-full.bg-slate-50.border-b.border-slate-200
    .max-w-7xl.mx-auto.px-4.py-3.flex.items-center.justify-between.text-xs(class="lg:px-16")
      nav.flex.items-center.gap-2.text-gray-500
        a.transition-colors(class="hover:text-vamos-red" href="/") Trang chủ
        span /
        a.transition-colors(class="hover:text-vamos-red" href="/account/profile") Tài khoản cá nhân
        span /
        span.text-slate-900.font-bold Lịch sử đơn hàng
      .hidden.items-center.gap-2.text-emerald-700.bg-emerald-50.px-3.py-1.rounded-full.font-medium(class="sm:flex")
        span 🛡️
        span Đồng kiểm &amp; Đổi size miễn phí trong 7 ngày

  //- ── MAIN ACCOUNT CONTAINER ──
  main.max-w-7xl.mx-auto.px-4.py-8(class="sm:px-6 lg:px-16")
    .grid.grid-cols-1.gap-8.items-start(class="lg:grid-cols-12")

      //- ── CỘT TRÁI: ACCOUNT SIDEBAR (3 cols) ──
      aside.space-y-6(class="lg:col-span-3")
        //- User Profile Card
        .bg-white.rounded-xl.p-5.border.border-slate-200.shadow-sm
          .flex.items-center.gap-3.pb-4.border-b.border-slate-100
            .w-12.h-12.rounded-full.bg-slate-900.text-white.flex.items-center.justify-center.font-bold.text-base.shrink-0
              = (user && user.full_name ? user.full_name : (user && user.email ? user.email : 'U')).charAt(0).toUpperCase()
            .overflow-hidden
              h2.text-sm.font-bold.text-slate-900.truncate= user && user.full_name ? user.full_name : 'Khách hàng VAMOS'
              p.text-xs.text-slate-400.truncate= user && user.email ? user.email : ''
              span.inline-flex.items-center.gap-1.text-xs.font-bold.text-vamos-red.mt-1
                span 🏅
                | Thành viên VIP

        //- Navigation Menu Links
        .bg-white.rounded-xl.p-3.border.border-slate-200.shadow-sm
          nav.space-y-1.text-xs.font-semibold
            a.flex.items-center.justify-between.px-3.py-2-5.rounded-lg.bg-red-50.text-vamos-red.font-bold(class="py-2.5")
              .flex.items-center.gap-3
                span 📦
                span Đơn hàng của tôi
              span.text-xs.bg-red-100.text-vamos-red.px-2.rounded-full.font-bold(class="py-0.5")= (orders ? orders.length : 0)
            a.flex.items-center.justify-between.px-3.rounded-lg.text-slate-700.transition-colors(class="py-2.5 hover:bg-slate-50 hover:text-vamos-red" href="/account/profile")
              .flex.items-center.gap-3
                span 👤
                span Thông tin tài khoản
              span →
            a.flex.items-center.justify-between.px-3.rounded-lg.text-slate-700.transition-colors(class="py-2.5 hover:bg-slate-50 hover:text-vamos-red" href="/account/addresses")
              .flex.items-center.gap-3
                span 📍
                span Sổ địa chỉ giao hàng
              span →

        //- Hotline Support Card
        .bg-slate-900.text-white.p-4.rounded-xl.flex.items-center.gap-3.shadow-sm
          .w-10.h-10.rounded-lg.bg-white-10.flex.items-center.justify-center.text-vamos-red.text-xl.shrink-0 📞
          div
            h4.text-xs.font-bold.text-white Cần hỗ trợ đơn hàng?
            p.text-xs.text-slate-400 Tổng đài miễn phí: 1900 2126

      //- ── CỘT PHẢI: ORDER MANAGEMENT CENTER (9 cols) ──
      section.space-y-6(class="lg:col-span-9")
        //- Header Row
        .bg-white.rounded-xl.p-6.border.border-slate-200.shadow-sm.flex.flex-col.gap-4(class="md:flex-row md:items-center md:justify-between")
          div
            h1.text-xl.font-black.text-slate-900.tracking-tight(style="font-family:'Space Grotesk',sans-serif")
              | ĐƠN HÀNG CỦA TÔI
            p.text-xs.text-slate-500.mt-1 Theo dõi tiến trình xử lý, tra cứu và quản lý đơn hàng COD của bạn.

        if orders && orders.length > 0
          .space-y-4
            each o in orders
              article.bg-white.rounded-xl.border.border-slate-200.shadow-sm.overflow-hidden.transition-all(class="hover:border-slate-300")
                //- Card Header
                .p-4.bg-slate-50.border-b.border-slate-100.flex.flex-wrap.items-center.justify-between.gap-3(class="sm:p-5")
                  .flex.items-center.gap-3
                    span.text-xl 📦
                    div
                      .flex.items-center.gap-2
                        span.font-bold.text-sm.text-slate-900(style="font-family:'Space Grotesk',sans-serif")= `#${o.order_code}`
                        //- Status Badge
                        if o.order_status === 'PENDING'
                          span.px-2.rounded-full.text-xs.font-bold.bg-amber-100.text-amber-800(class="py-0.5") CHỜ XÁC NHẬN (PENDING)
                        else if o.order_status === 'CONFIRMED'
                          span.px-2.rounded-full.text-xs.font-bold.bg-blue-100.text-blue-800(class="py-0.5") ĐÃ XÁC NHẬN
                        else if o.order_status === 'SHIPPING'
                          span.px-2.rounded-full.text-xs.font-bold.bg-purple-100.text-purple-800(class="py-0.5") ĐANG GIAO HÀNG
                        else if o.order_status === 'COMPLETED' || o.order_status === 'DELIVERED'
                          span.px-2.rounded-full.text-xs.font-bold.bg-emerald-100.text-emerald-800(class="py-0.5") GIAO THÀNH CÔNG
                        else if o.order_status === 'CANCELLED'
                          span.px-2.rounded-full.text-xs.font-bold.bg-red-100.text-red-700(class="py-0.5") ĐÃ HỦY ĐƠN
                      p.text-xs.text-slate-500(class="mt-0.5")= `Ngày đặt: ${new Date(o.created_at).toLocaleString('vi-VN')}`

                  .text-right
                    span.text-xs.text-slate-400.block Tổng thanh toán COD
                    span.text-base.font-black.text-vamos-red(style="font-family:'Space Grotesk',sans-serif")
                      = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(o.total_amount)

                //- 5-Step Order Timeline Tracker (Stitch Design Handoff)
                .px-6.bg-slate-50.border-b.border-slate-100(class="py-5")
                  .grid.grid-cols-5.relative
                    //- Timeline connecting line
                    - const statusLevels = { 'PENDING': 1, 'CONFIRMED': 2, 'PROCESSING': 3, 'SHIPPING': 4, 'COMPLETED': 5, 'DELIVERED': 5, 'CANCELLED': 0 }
                    - const currentLevel = statusLevels[o.order_status] || 1
                    .absolute.left-0.right-0.h-1.bg-slate-200.z-0(class="top-1/2 -translate-y-1/2")
                      .h-full.bg-emerald-500.transition-all(style=`width: ${o.order_status === 'CANCELLED' ? 0 : Math.min(100, Math.max(0, (currentLevel - 1) * 25))}%`)
                    
                    //- Step 1: Đặt hàng
                    .relative.z-10.flex.flex-col.items-center.text-center
                      .w-7.h-7.rounded-full.text-white.flex.items-center.justify-center.text-xs.font-bold(class=currentLevel >= 1 && o.order_status !== 'CANCELLED' ? "bg-emerald-500" : "bg-slate-300") ✓
                      span.text-xs.font-bold.text-slate-900(class="mt-1.5") Đặt hàng
                    
                    //- Step 2: Chờ xác nhận
                    .relative.z-10.flex.flex-col.items-center.text-center
                      .w-7.h-7.rounded-full.text-white.flex.items-center.justify-center.text-xs.font-bold(class=currentLevel >= 2 ? "bg-emerald-500" : (currentLevel === 1 ? "bg-amber-500 ring-2 ring-amber-200" : "bg-slate-300"))
                        if currentLevel > 2
                          | ✓
                        else
                          | 2
                      span.text-xs.font-bold(class=currentLevel === 1 ? "mt-1.5 text-amber-800" : (currentLevel > 1 ? "mt-1.5 text-slate-900" : "mt-1.5 text-slate-400")) Xác nhận
                    
                    //- Step 3: Đóng gói
                    .relative.z-10.flex.flex-col.items-center.text-center
                      .w-7.h-7.rounded-full.text-white.flex.items-center.justify-center.text-xs.font-bold(class=currentLevel >= 3 ? "bg-emerald-500" : "bg-slate-300")
                        if currentLevel > 3
                          | ✓
                        else
                          | 3
                      span.text-xs.font-bold(class=currentLevel >= 3 ? "mt-1.5 text-slate-900" : "mt-1.5 text-slate-400") Đóng gói
                    
                    //- Step 4: Đang giao
                    .relative.z-10.flex.flex-col.items-center.text-center
                      .w-7.h-7.rounded-full.text-white.flex.items-center.justify-center.text-xs.font-bold(class=currentLevel >= 4 ? "bg-emerald-500" : "bg-slate-300")
                        if currentLevel > 4
                          | ✓
                        else
                          | 4
                      span.text-xs.font-bold(class=currentLevel >= 4 ? "mt-1.5 text-slate-900" : "mt-1.5 text-slate-400") Đang giao
                    
                    //- Step 5: Hoàn thành
                    .relative.z-10.flex.flex-col.items-center.text-center
                      .w-7.h-7.rounded-full.text-white.flex.items-center.justify-center.text-xs.font-bold(class=currentLevel >= 5 ? "bg-emerald-500" : "bg-slate-300")
                        if currentLevel >= 5
                          | ✓
                        else
                          | 5
                      span.text-xs.font-bold(class=currentLevel >= 5 ? "mt-1.5 text-emerald-700" : "mt-1.5 text-slate-400") Hoàn thành

                //- Order Footer Actions & Q8 Policy
                .p-4.bg-white.flex.flex-col.gap-3.items-start.justify-between(class="sm:p-5 sm:flex-row sm:items-center")
                  .text-xs.text-slate-600
                    span= `${o.item_count || 1} sản phẩm`
                    span.mx-2 |
                    span= `Thanh toán: ${o.payment_method}`
                    if o.order_status === 'PENDING'
                      span.block.text-xs.text-amber-800.mt-1.font-medium
                        | 💡 Đơn hàng đang Chờ xác nhận. Hủy đơn sẽ tự động hoàn lại tồn kho và hoàn trả voucher đã áp dụng.

                  .flex.items-center.gap-2.shrink-0
                    a.btn-outline.text-xs.px-4(class="py-2" href=`/account/orders/${o.id}`)
                      | Xem chi tiết
                    if o.order_status === 'PENDING'
                      form(action=`/account/orders/${o.id}/cancel` method="POST" onsubmit="return confirm('Xác nhận: Bạn có chắc chắn muốn hủy đơn hàng này không? Tồn kho sản phẩm và mã voucher (nếu có) sẽ được tự động hoàn lại!')")
                        input(type="hidden" name="_csrf" value=csrfToken)
                        button.btn-outline-red.text-xs.px-4(class="py-2" type="submit")
                          | HỦY ĐƠN HÀNG

        else
          //- Empty State
          .bg-white.p-12.rounded-xl.border.border-slate-200.text-center.shadow-sm
            .text-5xl.mb-3 📦
            h3.text-base.font-bold.text-slate-900.mb-1(style="font-family:'Space Grotesk',sans-serif") Bạn chưa có đơn hàng nào
            p.text-xs.text-slate-400.mb-5 Hãy dạo một vòng cửa hàng và chọn cho mình một đôi giày ưng ý nhé!
            a.btn-primary.text-xs.px-6.py-3.inline-block(href="/products") Mua Sắm Ngay
