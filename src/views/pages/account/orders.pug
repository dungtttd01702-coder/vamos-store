extends ../../layouts/main

block content
  .bg-vamos-bg-light.py-3.border-b.border-vamos-border
    .vamos-container
      nav.text-xs.text-gray-500.flex.items-center.gap-2
        a.transition-colors(class="hover:text-vamos-red" href="/") Trang chủ
        span /
        span.text-vamos-dark.font-bold Lịch sử đơn hàng

  .vamos-container.py-8
    .flex.flex-col.gap-8(class="lg:flex-row")
      //- Left Account Menu
      aside.w-full.flex-shrink-0(class="lg:w-64")
        .bg-white.p-5.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card
          .flex.items-center.gap-3.pb-4.border-b.border-gray-100.mb-4
            .w-10.h-10.rounded-full.bg-vamos-dark.text-white.flex.items-center.justify-center.font-bold.text-sm
              = (user.full_name || user.email).charAt(0).toUpperCase()
            div
              .text-xs.font-bold.text-vamos-dark= user.full_name || 'Khách hàng'
              .text-xs.text-gray-400.truncate= user.email
          nav.space-y-1.text-xs.font-semibold
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.bg-red-50.text-vamos-red(href="/account/orders")
              span 📦
              span Đơn hàng của tôi
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.text-gray-700.transition-colors(class="hover:bg-gray-50 hover:text-vamos-red" href="/account/profile")
              span 👤
              span Thông tin tài khoản
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.text-gray-700.transition-colors(class="hover:bg-gray-50 hover:text-vamos-red" href="/account/addresses")
              span 📍
              span Sổ địa chỉ giao hàng

      //- Main Content Area
      main.flex-grow
        h1.text-2xl.font-black.text-vamos-dark.mb-6(style="font-family:'Space Grotesk',sans-serif")
          | LỊCH SỬ ĐƠN HÀNG CỦA TÔI

        if orders && orders.length > 0
          .space-y-4
            each o in orders
              .bg-white.p-5.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card.transition-all(class="hover:border-gray-300")
                .flex.flex-col.gap-3.pb-3.border-b.border-gray-100(class="sm:flex-row sm:items-center sm:justify-between")
                  div
                    span.font-bold.text-sm.text-vamos-dark(style="font-family:'Space Grotesk',sans-serif")= `#${o.order_code}`
                    span.text-xs.text-gray-400.ml-2= new Date(o.created_at).toLocaleDateString('vi-VN')
                  
                  //- Status Badge
                  div
                    if o.order_status === 'PENDING'
                      span.py-1.rounded-full.text-xs.font-bold.bg-orange-100.text-orange-700(class="px-2.5") Chờ xác nhận
                    else if o.order_status === 'CONFIRMED'
                      span.py-1.rounded-full.text-xs.font-bold.bg-blue-100.text-blue-700(class="px-2.5") Đã xác nhận
                    else if o.order_status === 'SHIPPING'
                      span.py-1.rounded-full.text-xs.font-bold.bg-purple-100.text-purple-700(class="px-2.5") Đang giao hàng
                    else if o.order_status === 'COMPLETED' || o.order_status === 'DELIVERED'
                      span.py-1.rounded-full.text-xs.font-bold.bg-green-100.text-green-700(class="px-2.5") Đã hoàn tất & Giao thành công
                    else if o.order_status === 'CANCELLED'
                      span.py-1.rounded-full.text-xs.font-bold.bg-red-100.text-red-700(class="px-2.5") Đã hủy đơn

                .flex.flex-col.gap-3.pt-3(class="sm:flex-row sm:items-center sm:justify-between")
                  .text-xs.text-gray-600(class="space-y-0.5")
                    p
                      span= `${o.item_count} sản phẩm`
                      span.mx-2 |
                      span= `Thanh toán: ${o.payment_method}`
                    p
                      span Tổng tiền COD:&nbsp;
                      span.font-bold.text-vamos-red.text-sm(style="font-family:'Space Grotesk',sans-serif")
                        = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(o.total_amount)

                  .flex.items-center.gap-2
                    a.btn-outline.text-xs.py-2.px-4(href=`/account/orders/${o.id}`)
                      | Xem chi tiết
                    if o.order_status === 'PENDING'
                      form(action=`/account/orders/${o.id}/cancel` method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Tồn kho sẽ được tự động hoàn lại.')")
                        button.btn-outline-red.text-xs.py-2.px-4(type="submit")
                          | Hủy đơn
        else
          .bg-white.p-12.rounded-vamos-xl.border.border-vamos-border.text-center.shadow-vamos-card
            .text-4xl.mb-3 📦
            h3.text-base.font-bold.text-vamos-dark.mb-1 Bạn chưa có đơn hàng nào
            p.text-xs.text-gray-400.mb-4 Hãy lựa chọn cho mình một đôi giày ưng ý tại VAMOS STORE nhé!
            a.btn-primary.text-xs(href="/products") Khám Phá Sản Phẩm Ngay
