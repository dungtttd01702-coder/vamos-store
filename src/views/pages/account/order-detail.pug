extends ../../layouts/main

block content
  .bg-vamos-bg-light.py-3.border-b.border-vamos-border
    .vamos-container
      nav.text-xs.text-gray-500.flex.items-center.gap-2
        a.transition-colors(class="hover:text-vamos-red" href="/") Trang chủ
        span /
        a.transition-colors(class="hover:text-vamos-red" href="/account/orders") Lịch sử đơn hàng
        span /
        span.text-vamos-dark.font-bold= `#${order.order_code}`

  .vamos-container.py-8
    .flex.flex-col.gap-8(class="lg:flex-row")
      //- Left Account Menu
      aside.w-full.flex-shrink-0(class="lg:w-64")
        .bg-white.p-5.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card
          .flex.items-center.gap-3.pb-4.border-b.border-gray-100.mb-4
            .w-10.h-10.rounded-full.bg-vamos-dark.text-white.flex.items-center.justify-center.font-bold.text-sm
              = (user.full_name || user.email).charAt(0).toUpperCase()
            div
              .text-xs.font-bold.text-vamos-dark= user.full_name || 'Khách hàng'
              .text-xs.text-gray-400.truncate= user.email
          nav.space-y-1.text-xs.font-semibold
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.bg-red-50.text-vamos-red(href="/account/orders")
              span 📦
              span Đơn hàng của tôi
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.text-gray-700.transition-colors(class="hover:bg-gray-50 hover:text-vamos-red" href="/account/profile")
              span 👤
              span Thông tin tài khoản
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.text-gray-700.transition-colors(class="hover:bg-gray-50 hover:text-vamos-red" href="/account/addresses")
              span 📍
              span Sổ địa chỉ giao hàng

      //- Main Content Area
      main.flex-grow
        .bg-white.p-6.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card
          //- Header Row
          .flex.flex-col.gap-4.pb-4.border-b.border-gray-100(class="sm:flex-row sm:items-center sm:justify-between")
            div
              h1.text-xl.font-black.text-vamos-dark(style="font-family:'Space Grotesk',sans-serif")
                = `CHI TIẾT ĐƠN HÀNG #${order.order_code}`
              p.text-xs.text-gray-400(class="mt-0.5")
                = `Đặt ngày: ${new Date(order.created_at).toLocaleString('vi-VN')}`

            //- Status Badge & Cancel Button
            .flex.items-center.gap-3
              if order.order_status === 'PENDING'
                span.px-3.py-1.rounded-full.text-xs.font-bold.bg-orange-100.text-orange-700 Chờ xác nhận
                form(action=`/account/orders/${order.id}/cancel` method="POST" onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không? Tồn kho sẽ được tự động hoàn lại.')")
                  button.btn-outline-red.text-xs.py-2.px-4(type="submit")
                    | Hủy Đơn Hàng
              else if order.order_status === 'CONFIRMED'
                span.px-3.py-1.rounded-full.text-xs.font-bold.bg-blue-100.text-blue-700 Đã xác nhận
              else if order.order_status === 'SHIPPING'
                span.px-3.py-1.rounded-full.text-xs.font-bold.bg-purple-100.text-purple-700 Đang giao hàng
              else if order.order_status === 'DELIVERED'
                span.px-3.py-1.rounded-full.text-xs.font-bold.bg-green-100.text-green-700 Đã nhận hàng
              else if order.order_status === 'CANCELLED'
                span.px-3.py-1.rounded-full.text-xs.font-bold.bg-red-100.text-red-700 Đã hủy đơn

          //- Delivery Info
          .grid.grid-cols-1.gap-6.py-6.border-b.border-gray-100(class="md:grid-cols-2")
            div
              h3.text-xs.font-bold.text-vamos-dark.uppercase.tracking-wider.mb-2 ĐỊA CHỈ NHẬN HÀNG
              .text-xs.text-gray-600.space-y-1
                p.font-bold.text-vamos-dark= order.recipient_name_snapshot
                p= `Điện thoại: ${order.recipient_phone_snapshot}`
                p= `Địa chỉ: ${order.delivery_address_snapshot}`
                if order.customer_note
                  p.italic.text-gray-400= `Ghi chú: ${order.customer_note}`

            div
              h3.text-xs.font-bold.text-vamos-dark.uppercase.tracking-wider.mb-2 HÌNH THỨC THANH TOÁN
              .text-xs.text-gray-600.space-y-1
                p.font-bold.text-vamos-dark COD – Tiền mặt khi nhận hàng
                p
                  span Trạng thái:&nbsp;
                  if order.payment_status === 'UNPAID'
                    span.font-semibold.text-orange-600 Chưa thanh toán (Trả khi nhận hàng)
                  else
                    span.font-semibold.text-green-600 Đã thanh toán

          //- Ordered Items Table
          .py-6.border-b.border-gray-100
            h3.text-xs.font-bold.text-vamos-dark.uppercase.tracking-wider.mb-4 SẢN PHẨM TRONG ĐƠN
            .divide-y.divide-gray-100
              each it in order.items
                .py-3.flex.items-center.justify-between.gap-4
                  .flex.items-center.gap-3
                    if it.image_url
                      img.w-12.h-12.rounded-lg.object-contain.border.border-gray-100.p-1.bg-gray-50(src=it.image_url alt=it.product_name_snapshot)
                    else
                      .w-12.h-12.rounded-lg.bg-gray-50.flex.items-center.justify-center.text-xs.text-gray-400 SP
                    div
                      h4.text-xs.font-bold.text-vamos-dark= it.product_name_snapshot
                      p.text-xs.text-gray-400= `Màu: ${it.color_snapshot} | Size: ${it.size_snapshot} | SKU: ${it.sku_snapshot}`
                  .text-right
                    .text-xs.text-gray-400= `${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(it.unit_price)} x ${it.quantity}`
                    .text-xs.font-bold.text-vamos-dark(style="font-family:'Space Grotesk',sans-serif")
                      = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(it.line_total)

          //- Pricing Summary
          .py-6.space-y-2.text-xs(class="sm:w-80 sm:ml-auto")
            .flex.justify-between
              span.text-gray-500 Tiền hàng:
              span.font-bold= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.subtotal)
            if order.discount_amount > 0
              .flex.justify-between.text-vamos-red
                span Giảm giá voucher:
                span.font-bold= `-${new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.discount_amount)}`
            .flex.justify-between
              span.text-gray-500 Phí vận chuyển:
              span.font-bold= order.shipping_fee === 0 ? 'Miễn phí' : new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.shipping_fee)
            .border-t.border-gray-200.pt-2.flex.justify-between.items-baseline.text-sm
              span.font-bold.text-vamos-dark Tổng thanh toán COD:
              span.text-xl.font-black.text-vamos-red(style="font-family:'Space Grotesk',sans-serif")
                = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(order.total_amount)

          //- Order Status History
          if order.histories && order.histories.length > 0
            .pt-6.border-t.border-gray-100
              h3.text-xs.font-bold.text-vamos-dark.uppercase.tracking-wider.mb-3 LỊCH SỬ TRẠNG THÁI
              .space-y-2
                each h in order.histories
                  .flex.items-start.gap-3.text-xs
                    span.w-2.h-2.rounded-full.bg-vamos-red.mt-1.flex-shrink-0
                    div
                      .font-bold.text-vamos-dark= `Chuyển trạng thái: ${h.new_status}`
                      p.text-gray-400= `${new Date(h.created_at).toLocaleString('vi-VN')} - ${h.note || ''}`
