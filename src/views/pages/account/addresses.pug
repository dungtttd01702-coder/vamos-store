extends ../../layouts/main

block content
  .bg-vamos-bg-light.py-3.border-b.border-vamos-border
    .vamos-container
      nav.text-xs.text-gray-500.flex.items-center.gap-2
        a.transition-colors(class="hover:text-vamos-red" href="/") Trang chủ
        span /
        span.text-vamos-dark.font-bold Sổ địa chỉ

  .vamos-container.py-8
    .flex.flex-col.gap-8(class="lg:flex-row")
      //- Left Account Menu
      aside.w-full.flex-shrink-0(class="lg:w-64")
        .bg-white.p-5.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card
          .flex.items-center.gap-3.pb-4.border-b.border-gray-100.mb-4
            .w-10.h-10.rounded-full.bg-vamos-dark.text-white.flex.items-center.justify-center.font-bold.text-sm
              = (user.full_name || user.email).charAt(0).toUpperCase()
            div
              .text-xs.font-bold.text-vamos-dark= user.full_name || 'Khách hàng'
              .text-xs.text-gray-400.truncate= user.email
          nav.space-y-1.text-xs.font-semibold
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.text-gray-700.transition-colors(class="hover:bg-gray-50 hover:text-vamos-red" href="/account/orders")
              span 📦
              span Đơn hàng của tôi
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.text-gray-700.transition-colors(class="hover:bg-gray-50 hover:text-vamos-red" href="/account/profile")
              span 👤
              span Thông tin tài khoản
            a.flex.items-center.gap-2.px-3.py-2.rounded-lg.bg-red-50.text-vamos-red(href="/account/addresses")
              span 📍
              span Sổ địa chỉ giao hàng

      //- Main Content Area
      main.flex-grow
        h1.text-xl.font-black.text-vamos-dark.mb-6(style="font-family:'Space Grotesk',sans-serif")
          | SỔ ĐỊA CHỈ GIAO HÀNG (COD)

        //- Existing Addresses
        if addresses && addresses.length > 0
          .grid.grid-cols-1.gap-4.mb-8(class="md:grid-cols-2")
            each a in addresses
              .bg-white.p-5.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card.relative
                if a.is_default
                  span.badge-sale.absolute.top-4.right-4 Mặc Định
                h3.font-bold.text-sm.text-vamos-dark= a.recipient_name
                p.text-xs.text-gray-500.mt-1= `Điện thoại: ${a.phone || a.phone_number}`
                p.text-xs.text-gray-600.mt-2= `${a.detail_address || a.address_line}, ${a.ward}, ${a.district}, ${a.province}`

        //- Add New Address Card
        .bg-white.p-6.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card.max-w-xl
          h2.text-sm.font-bold.text-vamos-dark.pb-3.border-b.border-gray-100.mb-4(style="font-family:'Space Grotesk',sans-serif")
            | THÊM ĐỊA CHỈ MỚI
          form.space-y-4(action="/account/addresses" method="POST")
            input(type="hidden" name="_csrf" value=csrfToken)
            .grid.grid-cols-1.gap-4(class="sm:grid-cols-2")
              div
                label.form-label(for="recipient_name") Họ tên người nhận *
                input#recipient_name.form-input(type="text" name="recipient_name" placeholder="Ví dụ: Nguyễn Văn A" required)
              div
                label.form-label(for="phone") Số điện thoại *
                input#phone.form-input(type="tel" name="phone" placeholder="Ví dụ: 0901234567" pattern="(0|\\+84)[3|5|7|8|9][0-9]{8}" required)

            .grid.grid-cols-1.gap-4(class="sm:grid-cols-3")
              div
                label.form-label(for="province") Tỉnh/Thành phố *
                input#province.form-input(type="text" name="province" placeholder="Đà Nẵng" required)
              div
                label.form-label(for="district") Quận/Huyện *
                input#district.form-input(type="text" name="district" placeholder="Liên Chiểu" required)
              div
                label.form-label(for="ward") Phường/Xã *
                input#ward.form-input(type="text" name="ward" placeholder="Hòa Khánh Bắc" required)

            div
              label.form-label(for="detail_address") Số nhà, tên đường cụ thể *
              input#detail_address.form-input(type="text" name="detail_address" placeholder="Ví dụ: 137 Nguyễn Thị Thập" required)

            .flex.items-center.gap-2
              input#is_default.text-vamos-red(type="checkbox" name="is_default" value="1")
              label.text-xs.text-gray-700.cursor-pointer(for="is_default") Đặt làm địa chỉ mặc định

            button.btn-primary.text-xs.py-3.px-6(type="submit")
              | Thêm Địa Chỉ

