extends ../../layouts/main

block content
  //- 1. Breadcrumbs
  .bg-slate-50.border-b.border-slate-200.py-3
    .max-w-7xl.mx-auto.px-4(class="sm:px-6 lg:px-8")
      nav.flex.items-center.gap-2.text-xs.font-medium.text-slate-500
        a.transition-colors(class="hover:text-slate-900" href="/") Trang chủ
        span /
        span.text-slate-900.font-semibold Ưu đãi & Khuyến Mãi HOT

  //- 2. Hero Banner Khuyến Mãi
  .bg-slate-900.text-white.py-12.border-b.border-slate-800.relative.overflow-hidden
    .absolute.w-96.h-96.bg-red-600.rounded-full.filter.blur-3xl.opacity-20.pointer-events-none(class="-right-20 -top-20")
    .max-w-7xl.mx-auto.px-4.relative.z-10(class="sm:px-6 lg:px-8")
      .text-center.max-w-3xl.mx-auto
        span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-black.bg-red-600.text-white.tracking-wider.uppercase.mb-3 🔥 ƯU ĐÃI ĐỘC QUYỀN VAMOS
        h1.text-3xl.font-black.tracking-tight.text-white(class="sm:text-4xl" style="font-family:'Space Grotesk',sans-serif")
          | SIÊU SALE GIÀY THỂ THAO & SANDAL
        p.text-xs.text-slate-300.mt-3.leading-relaxed(class="sm:text-sm")
          | Nhận ngay mã giảm giá đến 100.000₫, miễn phí giao hàng toàn quốc khi thanh toán COD và trải nghiệm các thiết kế thể thao đỉnh cao cùng VAMOS STORE.

  //- 3. Mã Giảm Giá & Voucher Section
  .max-w-7xl.mx-auto.px-4.py-12(class="sm:px-6 lg:px-8")
    .text-center.mb-8
      h2.text-xl.font-black.text-slate-900.uppercase.tracking-tight(style="font-family:'Space Grotesk',sans-serif")
        | MÃ GIẢM GIÁ ĐANG ÁP DỤNG
      p.text-xs.text-slate-500.mt-1 Nhấn để sao chép mã và dán tại màn hình giỏ hàng / đặt hàng

    .grid.grid-cols-1.gap-6.max-w-5xl.mx-auto(class="md:grid-cols-3")
      //- Voucher 1
      .bg-white.p-6.rounded-2xl.border-2.border-dashed.border-red-300.shadow-sm.flex.flex-col.justify-between.relative.overflow-hidden.transition-all(class="hover:shadow-md hover:border-red-400")
        .flex.items-center.justify-between.mb-3
          span.rounded-md.bg-red-100.text-red-700.text-2xs.font-black.tracking-wider(class="px-2.5 py-1") GIẢM 50.000Đ
          span.text-xs.text-slate-400 HSD: 31/12
        div
          h3.text-2xl.font-black.text-slate-900.tracking-tight(style="font-family:'Space Grotesk',sans-serif") VAMOS50K
          p.text-xs.text-slate-500.mt-2.leading-relaxed Áp dụng cho đơn hàng từ 500.000₫ khi mua bất kỳ mẫu giày thể thao hoặc sandal nào.
        button.w-full.mt-5.bg-red-600.text-white.text-xs.font-bold.rounded-xl.shadow-sm.transition-all(
          class="py-2.5 px-4 hover:bg-red-700 shadow-red-500/20 flex items-center justify-center gap-2"
          type="button"
          onclick="copyVoucher('VAMOS50K', this)"
        )
          svg.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z")
          span SAO CHÉP MÃ

      //- Voucher 2
      .bg-white.p-6.rounded-2xl.border-2.border-dashed.border-amber-300.shadow-sm.flex.flex-col.justify-between.relative.overflow-hidden.transition-all(class="hover:shadow-md hover:border-amber-400")
        .flex.items-center.justify-between.mb-3
          span.rounded-md.bg-amber-100.text-amber-800.text-2xs.font-black.tracking-wider(class="px-2.5 py-1") GIẢM 100.000Đ
          span.text-xs.text-slate-400 HSD: 31/12
        div
          h3.text-2xl.font-black.text-slate-900.tracking-tight(style="font-family:'Space Grotesk',sans-serif") VAMOS100
          p.text-xs.text-slate-500.mt-2.leading-relaxed Áp dụng cho đơn hàng từ 1.000.000₫ trở lên, áp dụng đồng thời với ưu đãi giảm giá thẻ sản phẩm.
        button.w-full.mt-5.bg-slate-900.text-white.text-xs.font-bold.rounded-xl.shadow-sm.transition-all(
          class="py-2.5 px-4 hover:bg-red-600 flex items-center justify-center gap-2"
          type="button"
          onclick="copyVoucher('VAMOS100', this)"
        )
          svg.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z")
          span SAO CHÉP MÃ

      //- Voucher 3
      .bg-white.p-6.rounded-2xl.border-2.border-dashed.border-emerald-300.shadow-sm.flex.flex-col.justify-between.relative.overflow-hidden.transition-all(class="hover:shadow-md hover:border-emerald-400")
        .flex.items-center.justify-between.mb-3
          span.rounded-md.bg-emerald-100.text-emerald-800.text-2xs.font-black.tracking-wider(class="px-2.5 py-1") MIỄN PHÍ SHIP
          span.text-xs.text-slate-400 Vô thời hạn
        div
          h3.text-2xl.font-black.text-slate-900.tracking-tight(style="font-family:'Space Grotesk',sans-serif") FREESHIP
          p.text-xs.text-slate-500.mt-2.leading-relaxed Tự động miễn 100% phí giao hàng COD toàn quốc cho tất cả đơn hàng có giá trị từ 500.000₫.
        .w-full.mt-5.bg-emerald-50.text-emerald-700.text-xs.font-bold.rounded-xl.border.border-emerald-200.text-center.flex.items-center.justify-center(class="py-2.5 px-4 gap-1.5")
          span ✓
          span ÁP DỤNG TỰ ĐỘNG KHI ĐẶT HÀNG

  //- 4. SẢN PHẨM KHUYẾN MÃI (LIVE PRODUCTS ON SALE)
  if products && products.length > 0
    .bg-slate-50.border-y.border-slate-200.py-14
      .max-w-7xl.mx-auto.px-4(class="sm:px-6 lg:px-8")
        .flex.flex-col.gap-3.mb-8(class="sm:flex-row sm:items-end sm:justify-between")
          div
            .flex.items-center.gap-2.mb-1
              span.w-3.h-3.rounded-full.bg-red-600.animate-ping
              h2.text-2xl.font-black.text-slate-900.uppercase.tracking-tight(style="font-family:'Space Grotesk',sans-serif")
                | SẢN PHẨM ĐANG GIẢM GIÁ HOT
            p.text-xs.text-slate-500 Danh sách các mẫu giày thể thao và sandal bán chạy nhất đang được ưu đãi đến 30%
          a.inline-flex.items-center.gap-1.text-xs.font-bold.text-red-600.transition-colors(class="hover:text-red-700" href="/products?sale=1")
            | Xem tất cả #{totalSale || ''} sản phẩm Sale &rarr;

        //- Grid Sản Phẩm Khuyến Mãi
        .grid.grid-cols-1.gap-6(class="sm:grid-cols-2 lg:grid-cols-4")
          each prod in products
            - const hasSale = prod.sale_price && Number(prod.sale_price) > 0 && Number(prod.sale_price) < Number(prod.base_price)
            - const discountPct = hasSale ? Math.round((1 - (Number(prod.sale_price) / Number(prod.base_price))) * 100) : 0

            .group.bg-white.rounded-xl.border.border-slate-200.p-4.transition-all.duration-300.relative.flex.flex-col.justify-between(
              class="hover:border-red-200 hover:shadow-xl hover:-translate-y-1"
            )
              div
                //- Header Card (Badge Sale + Icon Wishlist)
                .flex.items-center.justify-between.mb-2
                  if hasSale && discountPct > 0
                    span.rounded-md.bg-red-600.text-white.text-xs.font-black.tracking-wider(class="px-2.5 py-1")
                      = `-${discountPct}%`
                  else
                    span.rounded-md.bg-slate-900.text-white.text-xs.font-bold.tracking-wider(class="px-2.5 py-1")
                      | SALE

                  button.btn-wishlist.w-8.h-8.rounded-full.flex.items-center.justify-center.text-slate-400.transition-all(
                    class="hover:text-red-600 hover:bg-red-50 hover:scale-110 active:scale-95"
                    type="button"
                    title="Thêm vào yêu thích"
                    data-product-id=prod.id
                    data-product-name=prod.name
                    data-product-slug=prod.slug
                    data-product-price=(prod.sale_price || prod.base_price)
                    data-product-img=(prod.image_url || '/images/placeholder-shoe.png')
                  )
                    svg.w-4.h-4.transition-colors(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                      path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")

                //- Khung Ảnh Nền Trắng Studio
                a.relative.block.w-full.aspect-square.bg-slate-50.rounded-lg.p-4.overflow-hidden.flex.items-center.justify-center(href=`/products/${prod.slug}`)
                  if prod.image_url
                    img.w-full.h-full.object-contain.mix-blend-multiply.transition-transform.duration-500(
                      class="group-hover:scale-105"
                      src=prod.image_url
                      alt=prod.name
                      loading="lazy"
                    )

                //- Thông Tin Sản Phẩm
                .mt-3
                  span.text-2xs.font-bold.text-slate-400.uppercase.tracking-wider
                    = prod.brand_name || 'VAMOS ACTIVE'
                  a.block.text-sm.font-bold.text-slate-900.transition-colors.mt-1.line-clamp-1(
                    class="hover:text-red-600"
                    href=`/products/${prod.slug}`
                  )
                    = prod.name

                  //- Giá Bán Sale & Giá Gốc
                  .flex.items-baseline.gap-2.mt-2
                    if hasSale
                      span.text-base.font-black.text-red-600(style="font-family:'Space Grotesk',sans-serif")
                        = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(prod.sale_price)
                      span.text-xs.text-slate-400.line-through
                        = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(prod.base_price)
                    else
                      span.text-base.font-black.text-slate-900(style="font-family:'Space Grotesk',sans-serif")
                        = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(prod.base_price)

              //- Nút Xem Chi Tiết
              .mt-4.pt-3.border-t.border-slate-100
                a.w-full.px-4.rounded-lg.border.border-slate-200.bg-white.text-xs.font-bold.text-slate-800.flex.items-center.justify-center.transition-all.duration-200(
                  class="py-2.5 gap-1.5 hover:border-red-600 hover:bg-red-600 hover:text-white hover:shadow-md"
                  href=`/products/${prod.slug}`
                )
                  span XEM CHI TIẾT
                  svg(class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")

        //- Nút CTA To Toàn Bộ Sản Phẩm Sale
        .mt-10.text-center
          a.inline-flex.items-center.bg-red-600.text-white.text-xs.font-black.rounded-xl.shadow-lg.transition-all(
            class="gap-2 px-8 py-3.5 hover:bg-red-700 shadow-red-500/25 hover:shadow-xl hover:scale-105"
            href="/products?sale=1"
          )
            span XEM TẤT CẢ SẢN PHẨM KHUYẾN MÃI (SALE UP TO 30%)
            span &rarr;
