extends ../../layouts/main

block content
  //- 1. BREADCRUMBS & TIÊU ĐỀ
  .bg-slate-50.border-b.border-slate-200.py-3
    .max-w-7xl.mx-auto.px-4(class="sm:px-6 lg:px-8")
      nav.flex.items-center.gap-2.text-xs.font-medium.text-slate-500
        a.transition-colors(class="hover:text-slate-900" href="/") Trang chủ
        span /
        a.transition-colors(class="hover:text-slate-900" href="/products") Cửa hàng
        span /
        if currentCategory
          span.text-slate-900.font-semibold= currentCategory.name
        else
          span.text-slate-900.font-semibold Tất cả sản phẩm

  //- 2. KHU VỰC CHÍNH (SIDEBAR + GRID SẢN PHẨM)
  #catalog-pjax-container.max-w-7xl.mx-auto.px-4.py-8(class="sm:px-6 lg:px-8")
    .flex.flex-col.gap-8(class="lg:flex-row")

      //- SIDEBAR BỘ LỌC TÌM KIẾM (Cột Trái - 280px)
      aside.w-full.flex-shrink-0(class="lg:w-72")
        .bg-white.p-5.rounded-xl.border.border-slate-200.shadow-sm.sticky.top-24
          .flex.items-center.justify-between.pb-4.border-b.border-slate-100
            .flex.items-center.gap-2
              svg.w-5.h-5.text-red-600(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4")
              h3.text-sm.font-bold.text-slate-900.uppercase.tracking-wide(style="font-family:'Space Grotesk',sans-serif") Bộ Lọc Tìm Kiếm
            a.catalog-filter-link.text-xs.font-semibold.text-red-600.transition-colors(class="hover:text-red-700" href="/products") Đặt lại

          form#filterForm(method="GET" action="/products")
            if selectedFilters.sort
              input(type="hidden" name="sort" value=selectedFilters.sort)

            //- Lọc Danh mục
            .py-4.border-b.border-slate-100
              h4.text-xs.font-bold.text-slate-900.uppercase.tracking-wider.mb-3 Danh mục
              div(class="space-y-1.5")
                a.catalog-filter-link.flex.items-center.justify-between.text-xs.rounded-lg.transition-colors(
                  class=selectedFilters.cat === '' && !selectedFilters.sale ? 'font-bold bg-red-50 text-red-600 px-2.5 py-2' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 px-2.5 py-2'
                  href="/products"
                )
                  span Tất cả sản phẩm
                  span(class=selectedFilters.cat === '' && !selectedFilters.sale ? 'text-red-600 text-xxs font-bold' : 'text-slate-400 text-xxs')= `(${total})`

                //- Lọc Hàng Khuyến Mãi (Sale)
                a.catalog-filter-link.flex.items-center.justify-between.text-xs.rounded-lg.transition-colors(
                  class=selectedFilters.sale === '1' ? 'font-bold bg-red-50 text-red-600 px-2.5 py-2 border border-red-200' : 'font-medium text-slate-600 hover:text-red-600 hover:bg-slate-50 px-2.5 py-2'
                  href=selectedFilters.sale === '1' ? '/products' : `/products?sale=1${selectedFilters.cat ? `&cat=${selectedFilters.cat}` : ''}${selectedFilters.gender ? `&gender=${selectedFilters.gender}` : ''}`
                )
                  span.flex.items-center(class="gap-1.5")
                    span 🔥
                    span Đang giảm giá (Sale)
                  span.text-xxs.font-bold(class=selectedFilters.sale === '1' ? 'text-red-600' : 'text-slate-400') HOT

                each c in categories
                  a.catalog-filter-link.flex.items-center.justify-between.text-xs.rounded-lg.transition-colors(
                    class=selectedFilters.cat === c.slug ? 'font-bold bg-red-50 text-red-600 px-2.5 py-2' : 'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 px-2.5 py-2'
                    href=`/products?cat=${c.slug}${selectedFilters.gender ? `&gender=${selectedFilters.gender}` : ''}${selectedFilters.minPrice ? `&minPrice=${selectedFilters.minPrice}` : ''}${selectedFilters.maxPrice ? `&maxPrice=${selectedFilters.maxPrice}` : ''}${selectedFilters.sale ? `&sale=${selectedFilters.sale}` : ''}`
                  )
                    span= c.name
                    span(class=selectedFilters.cat === c.slug ? 'text-red-600 text-xxs font-bold' : 'text-slate-400 text-xxs')= `(${c.product_count})`

            if selectedFilters.cat
              input(type="hidden" name="cat" value=selectedFilters.cat)
            if selectedFilters.sale
              input(type="hidden" name="sale" value=selectedFilters.sale)

            //- Lọc Đối tượng (Gender) - Pill Buttons (Stitch Kinetic)
            .py-4.border-b.border-slate-100
              h4.text-xs.font-bold.text-slate-900.uppercase.tracking-wider.mb-3 Dành Cho
              .grid.grid-cols-2(class="gap-1.5")
                label.cursor-pointer
                  input.sr-only.peer(type="radio" name="gender" value="" checked=selectedFilters.gender === '')
                  .px-2.text-center.text-xs.font-semibold.rounded-lg.border.border-slate-200.transition-all(class="py-1.5 peer-checked:border-red-600 peer-checked:bg-red-50 peer-checked:text-red-600 hover:border-slate-300 text-slate-700")
                    | Tất cả
                label.cursor-pointer
                  input.sr-only.peer(type="radio" name="gender" value="MEN" checked=selectedFilters.gender === 'MEN')
                  .px-2.text-center.text-xs.font-semibold.rounded-lg.border.border-slate-200.transition-all(class="py-1.5 peer-checked:border-red-600 peer-checked:bg-red-50 peer-checked:text-red-600 hover:border-slate-300 text-slate-700")
                    | Nam
                label.cursor-pointer
                  input.sr-only.peer(type="radio" name="gender" value="WOMEN" checked=selectedFilters.gender === 'WOMEN')
                  .px-2.text-center.text-xs.font-semibold.rounded-lg.border.border-slate-200.transition-all(class="py-1.5 peer-checked:border-red-600 peer-checked:bg-red-50 peer-checked:text-red-600 hover:border-slate-300 text-slate-700")
                    | Nữ
                label.cursor-pointer
                  input.sr-only.peer(type="radio" name="gender" value="UNISEX" checked=selectedFilters.gender === 'UNISEX')
                  .px-2.text-center.text-xs.font-semibold.rounded-lg.border.border-slate-200.transition-all(class="py-1.5 peer-checked:border-red-600 peer-checked:bg-red-50 peer-checked:text-red-600 hover:border-slate-300 text-slate-700")
                    | Unisex

            //- Lọc Kích Cỡ EU (EU Size Grid - Stitch Spec)
            .py-4.border-b.border-slate-100
              .flex.items-center.justify-between.mb-3
                h4.text-xs.font-bold.text-slate-900.uppercase.tracking-wider Kích Cỡ (EU Size)
                span.text-2xs.text-slate-400 Chuẩn form
              .grid.grid-cols-4(class="gap-1.5")
                each sz in ['38', '39', '40', '41', '42', '43']
                  label.cursor-pointer
                    input.sr-only.peer(type="radio" name="size" value=sz checked=selectedFilters.size === sz)
                    .w-full.text-center.text-xs.font-bold.rounded-lg.border.border-slate-200.transition-all(class="py-1.5 peer-checked:border-red-600 peer-checked:bg-red-600 peer-checked:text-white hover:border-slate-400 text-slate-800")
                      = sz
                //- Size 44 Hết hàng (Q1 Ràng buộc: Disabled, nét đứt, gạch chéo)
                .w-full.text-center.text-xs.font-bold.rounded-lg.border.border-dashed.border-slate-300.text-slate-400.bg-slate-50.cursor-not-allowed.line-through.opacity-60(class="py-1.5" title="Size 44 hiện tạm hết hàng")
                  | 44

            //- Lọc Khoảng giá (Tự động submit khi nhập hoặc đổi giá)
            .py-4.border-b.border-slate-100
              .flex.items-center.justify-between.mb-3
                h4.text-xs.font-bold.text-slate-900.uppercase.tracking-wider Khoảng giá (VNĐ)
                span.text-2xs.text-slate-400 Tự động lọc
              .grid.grid-cols-2.gap-2.mb-3
                input#minPriceInput.w-full.px-3.py-2.text-xs.rounded-lg.border.border-slate-200.transition-colors(
                  class="focus:outline-none focus:border-red-600"
                  type="number"
                  name="minPrice"
                  placeholder="Từ..."
                  value=selectedFilters.minPrice
                )
                input#maxPriceInput.w-full.px-3.py-2.text-xs.rounded-lg.border.border-slate-200.transition-colors(
                  class="focus:outline-none focus:border-red-600"
                  type="number"
                  name="maxPrice"
                  placeholder="Đến..."
                  value=selectedFilters.maxPrice
                )
              //- Gợi ý mức giá chọn nhanh (Stitch Spec - Click để tự động lọc)
              - const isUnder500k = selectedFilters.maxPrice === '500000' && (!selectedFilters.minPrice || selectedFilters.minPrice === '0')
              - const is500kTo1M = selectedFilters.minPrice === '500000' && selectedFilters.maxPrice === '1000000'
              - const isOver1M = selectedFilters.minPrice === '1000000' && (!selectedFilters.maxPrice || selectedFilters.maxPrice === '')
              .flex.flex-col(class="space-y-1.5")
                button.preset-price-btn.text-left.text-xs.rounded-lg.transition-all.flex.items-center.justify-between(
                  class=isUnder500k ? 'px-2.5 py-2 bg-red-50 text-red-600 font-bold border border-red-200 shadow-xs' : 'px-2.5 py-2 text-slate-600 hover:bg-slate-50 hover:text-red-600 border border-transparent'
                  type="button"
                  data-min=""
                  data-max="500000"
                  data-active=isUnder500k ? 'true' : 'false'
                  onclick="window.selectPricePreset && window.selectPricePreset(this.dataset.min, this.dataset.max, this.dataset.active === 'true')"
                )
                  span Dưới 500k
                  if isUnder500k
                    span.text-red-600.font-bold ✓
                  else
                    span.text-slate-300 →
                button.preset-price-btn.text-left.text-xs.rounded-lg.transition-all.flex.items-center.justify-between(
                  class=is500kTo1M ? 'px-2.5 py-2 bg-red-50 text-red-600 font-bold border border-red-200 shadow-xs' : 'px-2.5 py-2 text-slate-600 hover:bg-slate-50 hover:text-red-600 border border-transparent'
                  type="button"
                  data-min="500000"
                  data-max="1000000"
                  data-active=is500kTo1M ? 'true' : 'false'
                  onclick="window.selectPricePreset && window.selectPricePreset(this.dataset.min, this.dataset.max, this.dataset.active === 'true')"
                )
                  span 500k - 1.000.000 ₫
                  if is500kTo1M
                    span.text-red-600.font-bold ✓
                  else
                    span.text-slate-300 →
                button.preset-price-btn.text-left.text-xs.rounded-lg.transition-all.flex.items-center.justify-between(
                  class=isOver1M ? 'px-2.5 py-2 bg-red-50 text-red-600 font-bold border border-red-200 shadow-xs' : 'px-2.5 py-2 text-slate-600 hover:bg-slate-50 hover:text-red-600 border border-transparent'
                  type="button"
                  data-min="1000000"
                  data-max=""
                  data-active=isOver1M ? 'true' : 'false'
                  onclick="window.selectPricePreset && window.selectPricePreset(this.dataset.min, this.dataset.max, this.dataset.active === 'true')"
                )
                  span Trên 1.000.000 ₫
                  if isOver1M
                    span.text-red-600.font-bold ✓
                  else
                    span.text-slate-300 →

            - const hasPriceVal = (selectedFilters.minPrice && Number(selectedFilters.minPrice) > 0) || (selectedFilters.maxPrice && Number(selectedFilters.maxPrice) > 0)
            - const isFiltered = Boolean(selectedFilters.cat || selectedFilters.gender || hasPriceVal || selectedFilters.size || selectedFilters.sale)
            if isFiltered
              .pt-3
                a.w-full.py-2.px-4.rounded-lg.border.border-slate-200.text-slate-600.text-xs.font-semibold.flex.items-center.justify-center.transition-colors(class="gap-1.5 hover:bg-slate-50 hover:text-slate-900" href="/products")
                  svg(class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
                  | Xóa tất cả bộ lọc

      //- CỘT PHẢI: HEADER DANH MỤC + ACTIVE FILTER TAGS + GRID SẢN PHẨM
      main.flex-1
        //- Toolbar Tiêu Đề & Sắp Xếp
        .flex.flex-col.gap-4.pb-6.border-b.border-slate-200(class="sm:flex-row sm:items-center sm:justify-between")
          div
            .flex.items-center.gap-3
              h1.text-2xl.font-black.text-slate-900.uppercase.tracking-tight(style="font-family:'Space Grotesk',sans-serif")
                = selectedFilters.sale === '1' ? '🔥 Sản Phẩm Khuyến Mãi HOT' : (currentCategory ? currentCategory.name : 'Tất Cả Giày Thể Thao')
              span.bg-slate-100.text-slate-700.text-xs.font-bold.px-3.py-1.rounded-full= `${total} SẢN PHẨM`
            p.text-xs.text-slate-500.mt-1
              = selectedFilters.sale === '1' ? 'Danh sách mẫu giày & sandal đang áp dụng ưu đãi giảm giá đến 30% tại VAMOS STORE.' : 'Đột phá công nghệ đệm trợ lực thế hệ mới cùng phong cách đường phố năng động.'

          //- Sắp xếp dropdown
          form.flex.items-center.gap-3(action="/products" method="GET")
            if selectedFilters.cat
              input(type="hidden" name="cat" value=selectedFilters.cat)
            if selectedFilters.gender
              input(type="hidden" name="gender" value=selectedFilters.gender)
            if selectedFilters.size
              input(type="hidden" name="size" value=selectedFilters.size)
            if selectedFilters.sale
              input(type="hidden" name="sale" value=selectedFilters.sale)
            if selectedFilters.minPrice
              input(type="hidden" name="minPrice" value=selectedFilters.minPrice)
            if selectedFilters.maxPrice
              input(type="hidden" name="maxPrice" value=selectedFilters.maxPrice)

            span.text-xs.font-medium.text-slate-500 Sắp xếp:
            select#sort-select.px-3.py-2.text-xs.font-bold.rounded-lg.border.border-slate-200.bg-white.text-slate-700.transition-colors(
              class="focus:outline-none focus:border-red-600"
              name="sort"
            )
              option(value="" selected=selectedFilters.sort === '') Mới nhất
              option(value="price_asc" selected=selectedFilters.sort === 'price_asc') Giá: Thấp đến Cao
              option(value="price_desc" selected=selectedFilters.sort === 'price_desc') Giá: Cao đến Thấp
              option(value="name_asc" selected=selectedFilters.sort === 'name_asc') Tên: A đến Z

        //- Active Filter Tags Bar (Chỉ hiển thị khi có bộ lọc thực sự)
        - const hasPriceFilter = (selectedFilters.minPrice && Number(selectedFilters.minPrice) > 0) || (selectedFilters.maxPrice && Number(selectedFilters.maxPrice) > 0)
        - const hasActiveFilters = Boolean(selectedFilters.cat || selectedFilters.gender || hasPriceFilter || selectedFilters.size || selectedFilters.sale)
        if hasActiveFilters
          .flex.flex-wrap.items-center.gap-2.py-4
            span.text-xs.font-medium.text-slate-400 Đang lọc:
            if selectedFilters.sale === '1'
              span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-bold.bg-red-50.text-red-600.border.border-red-200(class="gap-1.5")
                = '🔥 Đang giảm giá'
                a.text-red-400(class="hover:text-red-800" href=`/products?cat=${selectedFilters.cat || ''}&gender=${selectedFilters.gender || ''}&size=${selectedFilters.size || ''}&minPrice=${selectedFilters.minPrice || ''}&maxPrice=${selectedFilters.maxPrice || ''}`) ×
            if currentCategory
              span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-bold.bg-slate-100.text-slate-700(class="gap-1.5")
                = `Danh mục: ${currentCategory.name}`
                a.text-slate-400(class="hover:text-red-600" href=`/products?gender=${selectedFilters.gender || ''}&size=${selectedFilters.size || ''}&minPrice=${selectedFilters.minPrice || ''}&maxPrice=${selectedFilters.maxPrice || ''}&sale=${selectedFilters.sale || ''}`) ×
            if selectedFilters.gender
              span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-bold.bg-slate-100.text-slate-700(class="gap-1.5")
                = `Giới tính: ${selectedFilters.gender === 'MEN' ? 'Nam' : (selectedFilters.gender === 'WOMEN' ? 'Nữ' : 'Unisex')}`
                a.text-slate-400(class="hover:text-red-600" href=`/products?cat=${selectedFilters.cat || ''}&size=${selectedFilters.size || ''}&minPrice=${selectedFilters.minPrice || ''}&maxPrice=${selectedFilters.maxPrice || ''}&sale=${selectedFilters.sale || ''}`) ×
            if selectedFilters.size
              span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-bold.bg-slate-100.text-slate-700(class="gap-1.5")
                = `Size: ${selectedFilters.size}`
                a.text-slate-400(class="hover:text-red-600" href=`/products?cat=${selectedFilters.cat || ''}&gender=${selectedFilters.gender || ''}&minPrice=${selectedFilters.minPrice || ''}&maxPrice=${selectedFilters.maxPrice || ''}&sale=${selectedFilters.sale || ''}`) ×
            if hasPriceFilter
              span.inline-flex.items-center.px-3.py-1.rounded-full.text-xs.font-bold.bg-slate-100.text-slate-700(class="gap-1.5")
                = `Giá: ${selectedFilters.minPrice ? Number(selectedFilters.minPrice).toLocaleString('vi-VN') : '0'}₫ - ${selectedFilters.maxPrice ? Number(selectedFilters.maxPrice).toLocaleString('vi-VN') : '∞'}₫`
                a.text-slate-400(class="hover:text-red-600" href=`/products?cat=${selectedFilters.cat || ''}&gender=${selectedFilters.gender || ''}&size=${selectedFilters.size || ''}&sale=${selectedFilters.sale || ''}`) ×
            a.text-xs.font-semibold.text-red-600.ml-2(class="hover:underline" href="/products") Xóa tất cả

        //- PRODUCT GRID (Grid 3 Cột Hiện Đại Chuẩn Stitch)
        if products && products.length > 0
          .grid.grid-cols-1.gap-6.mt-2(class="sm:grid-cols-2 xl:grid-cols-3")
            each prod in products
              - const hasSale = prod.sale_price && Number(prod.sale_price) > 0 && Number(prod.sale_price) < Number(prod.base_price)
              - const discountPct = hasSale ? Math.round((1 - (Number(prod.sale_price) / Number(prod.base_price))) * 100) : 0

              .group.bg-white.rounded-xl.border.border-slate-200.p-4.transition-all.duration-300.relative.flex.flex-col.justify-between(
                class="hover:border-red-200 hover:shadow-xl hover:-translate-y-1"
              )
                div
                  //- Header Card (Badge Sale + Icon Wishlist)
                  .flex.items-center.justify-between.mb-2
                    if hasSale && discountPct > 0
                      span.rounded-md.bg-red-600.text-white.text-xs.font-black.tracking-wider(class="px-2.5 py-1")
                        = `-${discountPct}%`
                    else
                      span.rounded-md.bg-slate-900.text-white.text-xs.font-bold.tracking-wider(class="px-2.5 py-1")
                        | NEW
                    button.btn-wishlist.w-8.h-8.rounded-full.flex.items-center.justify-center.text-slate-400.transition-all(
                      class="hover:text-red-600 hover:bg-red-50 hover:scale-110 active:scale-95"
                      type="button"
                      title="Thêm vào yêu thích"
                      data-product-id=prod.id
                      data-product-name=prod.name
                      data-product-slug=prod.slug
                      data-product-price=(prod.sale_price || prod.base_price)
                      data-product-img=(prod.image_url || '/images/placeholder-shoe.png')
                    )
                      svg.w-4.h-4.transition-colors(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")

                  //- KHUNG ẢNH NỀN TRẮNG STUDIO (STITCH SPEC)
                  a.relative.block.w-full.aspect-square.bg-slate-50.rounded-lg.p-4.overflow-hidden.flex.items-center.justify-center(href=`/products/${prod.slug}`)
                    if prod.image_url
                      img.w-full.h-full.object-contain.mix-blend-multiply.transition-transform.duration-500(
                        class="group-hover:scale-105"
                        src=prod.image_url 
                        alt=prod.name
                        loading="lazy"
                      )
                    else
                      .text-slate-400.text-xs Chưa có ảnh

                    //- Quick Size Strip (Hiển thị khi hover như Stitch)
                    .absolute.bottom-2.left-2.right-2.bg-white(class="bg-opacity-95 backdrop-blur py-1.5 px-2 rounded-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 flex items-center justify-center gap-1.5 shadow-md z-10")
                      span.text-2xs.font-bold.text-slate-400.mr-1 Size:
                      each sz in ['39', '40', '41', '42']
                        span.text-xs.font-bold.px-1.text-slate-700= sz

                  //- THÔNG TIN SẢN PHẨM
                  .mt-4
                    .flex.items-center.justify-between
                      .text-xxs.font-bold.text-slate-400.uppercase.tracking-wider= prod.brand_name || 'VAMOS ORIGINALS'
                      if prod.total_stock !== undefined && prod.total_stock <= 5 && prod.total_stock > 0
                        span.text-2xs.font-bold.text-red-600= `🔥 Còn ${prod.total_stock} đôi`

                    a.block.text-sm.font-bold.text-slate-900.transition-colors.mt-1.line-clamp-1(
                      class="hover:text-red-600"
                      href=`/products/${prod.slug}`
                    )
                      = prod.name

                    //- Giá Tiền & Giá Gốc
                    .flex.items-baseline.gap-2.mt-2
                      if hasSale && discountPct > 0
                        span.text-base.font-extrabold.text-red-600(style="font-family:'Space Grotesk',sans-serif")
                          = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(prod.sale_price)
                        span.text-xs.text-slate-400.line-through
                          = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(prod.base_price)
                      else
                        span.text-base.font-extrabold.text-slate-900(style="font-family:'Space Grotesk',sans-serif")
                          = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(prod.base_price)

                    //- Color Dots Swatch Preview (Stitch Spec)
                    .flex.items-center.mt-2(class="gap-1.5")
                      span.rounded-full.bg-slate-900.ring-1.ring-slate-300(class="w-2.5 h-2.5")
                      span.rounded-full.bg-red-600(class="w-2.5 h-2.5")
                      span.rounded-full.bg-slate-200.border.border-slate-300(class="w-2.5 h-2.5")

                //- NÚT HÀNH ĐỘNG
                .mt-4.pt-3.border-t.border-slate-100
                  a.w-full.px-4.rounded-lg.border.border-slate-200.bg-white.text-xs.font-bold.text-slate-800.flex.items-center.justify-center.transition-all.duration-200(
                    class="py-2.5 gap-1.5 hover:border-red-600 hover:bg-red-600 hover:text-white hover:shadow-md"
                    href=`/products/${prod.slug}`
                  )
                    span XEM CHI TIẾT
                    svg(class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                      path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")

          //- Pagination
          if totalPages > 1
            .mt-10.flex.justify-center.items-center.gap-2
              each p in Array.from({ length: totalPages }, (_, i) => i + 1)
                a.w-9.h-9.flex.items-center.justify-center.rounded-lg.text-sm.font-bold.transition-colors(
                  class=p === page ? 'bg-red-600 text-white shadow-sm' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-50'
                  href=`/products?page=${p}${selectedFilters.cat ? `&cat=${selectedFilters.cat}` : ''}${selectedFilters.gender ? `&gender=${selectedFilters.gender}` : ''}${selectedFilters.size ? `&size=${selectedFilters.size}` : ''}${selectedFilters.sale ? `&sale=${selectedFilters.sale}` : ''}${selectedFilters.minPrice ? `&minPrice=${selectedFilters.minPrice}` : ''}${selectedFilters.maxPrice ? `&maxPrice=${selectedFilters.maxPrice}` : ''}${selectedFilters.q ? `&q=${encodeURIComponent(selectedFilters.q)}` : ''}${selectedFilters.sort ? `&sort=${selectedFilters.sort}` : ''}`
                )= p

        else
          .bg-white.p-12.rounded-xl.border.border-slate-200.text-center.mt-4.shadow-sm
            .text-4xl.mb-3 👟
            h3.text-base.font-bold.text-slate-900.mb-1 Chưa tìm thấy sản phẩm phù hợp
            p.text-xs.text-slate-500.mb-4 Hãy thử điều chỉnh lại bộ lọc hoặc xem danh mục khác.
            a.inline-flex.items-center.justify-center.px-5.rounded-lg.border.border-slate-300.text-xs.font-bold.text-slate-700(
              class="py-2.5 hover:border-red-600 hover:bg-red-50 hover:text-red-600 transition-colors"
              href="/products"
            ) Xem toàn bộ sản phẩm
