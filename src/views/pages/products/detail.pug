extends ../../layouts/main

block content
  //- ── BREADCRUMB ──
  .bg-vamos-bg-light.py-3.border-b.border-vamos-border
    .vamos-container
      nav.text-xs.text-gray-500.flex.items-center.gap-2
        a.transition-colors(class="hover:text-vamos-red" href="/") Trang chủ
        span /
        a.transition-colors(class="hover:text-vamos-red" href="/products") Cửa hàng
        span /
        if product.category_name
          a.transition-colors(class="hover:text-vamos-red" href=`/products?cat=${product.category_slug}`)= product.category_name
          span /
        span.text-vamos-dark.font-bold= product.name

  //- ── MAIN PRODUCT SECTION ──
  .vamos-container.py-8
    .bg-white.rounded-vamos-xl.border.border-vamos-border.p-6.shadow-vamos-card(class="lg:p-10")
      .grid.grid-cols-1.gap-10(class="lg:grid-cols-12")

        //- COLUMN 1: IMAGE GALLERY (5 cols)
        .space-y-4(class="lg:col-span-5")
          //- Main Large Image
          .relative.aspect-square.rounded-vamos-lg.overflow-hidden.bg-slate-50.border.border-slate-100.p-6.flex.items-center.justify-center
            if product.images && product.images.length > 0
              img#main-image.w-full.h-full.object-contain.mix-blend-multiply.transition-transform.duration-300(src=product.images[0].image_url alt=product.name)
            else
              .text-gray-400.text-sm Chưa có hình ảnh
            - const hasDiscount = product.sale_price && Number(product.sale_price) > 0 && Number(product.sale_price) < Number(product.base_price)
            - const discount = hasDiscount ? Math.round((1 - (Number(product.sale_price) / Number(product.base_price))) * 100) : 0
            if hasDiscount && discount > 0
              span.badge-sale.absolute.top-3.left-3= `-${discount}%`

          //- Thumbnails
          if product.images && product.images.length > 1
            .flex.items-center.gap-3.overflow-x-auto.pb-2
              each img, idx in product.images
                button.gallery-thumb-btn.w-16.h-16.rounded-lg.overflow-hidden.border-2.transition.flex-shrink-0.p-1.bg-slate-50(
                  class=idx === 0 ? 'border-vamos-red' : 'border-gray-200 hover:border-gray-400'
                  type="button"
                  data-image-url=img.image_url
                  aria-label=`Xem ảnh ${idx + 1}`
                )
                  img.w-full.h-full.object-contain.mix-blend-multiply(src=img.image_url alt=`Ảnh ${idx + 1}`)

        //- COLUMN 2: PRODUCT DETAILS & PURCHASE OPTIONS (7 cols)
        .flex.flex-col.justify-between(class="lg:col-span-7")
          div
            //- Brand & Code
            .flex.items-center.gap-2.mb-3
              span.badge-tag= product.brand_name || 'VAMOS'
              span.badge-tag= product.gender_target
              span#product-sku-display.text-xs.text-gray-400= `Mã SKU: ${product.variants && product.variants.length > 0 ? product.variants[0].sku : product.product_code}`

            //- Title
            h1.text-2xl.font-black.text-vamos-dark.leading-tight.mb-4(class="md:text-3xl" style="font-family:'Space Grotesk',sans-serif")
              = product.name

            //- Pricing Card
            .flex.items-baseline.gap-3.mb-6.p-4.bg-vamos-bg-light.rounded-vamos-lg.border.border-gray-100
              if hasDiscount && discount > 0
                span.text-3xl.font-black.text-vamos-red(style="font-family:'Space Grotesk',sans-serif")
                  = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.sale_price)
                span.text-base.text-gray-400.line-through
                  = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.base_price)
                span.badge-sale= `TIẾT KIỆM ${discount}%`
              else
                span.text-3xl.font-black.text-vamos-dark(style="font-family:'Space Grotesk',sans-serif")
                  = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.base_price)

            //- Purchase Form
            form(action="/cart/add" method="POST")
              input(type="hidden" name="_csrf" value=csrfToken)
              input(type="hidden" name="productId" value=product.id)

              //- Color Selector
              if availableColors && availableColors.length > 0
                .mb-6
                  label.block.text-xs.font-bold.text-vamos-dark.uppercase.tracking-wider.mb-2
                    | Màu Sắc
                    span#selected-color-label.text-vamos-red.font-bold= `: ${availableColors[0].name}`
                  .flex.flex-wrap.gap-3
                    each col, idx in availableColors
                      label.cursor-pointer
                        input.sr-only.peer(
                          type="radio"
                          name="color"
                          value=col.name
                          checked=idx === 0
                          required
                        )
                        .flex.items-center.gap-2.px-3.py-2.rounded-lg.border.border-gray-200.text-xs.font-semibold.text-gray-700.transition-all(class="peer-checked:border-vamos-red peer-checked:bg-red-50 peer-checked:text-vamos-red hover:border-gray-400")
                          if col.hex
                            span.w-3.h-3.rounded-full.border.border-gray-300(style=`background-color: ${col.hex}`)
                          span= col.name

              //- Size Selector
              if availableSizes && availableSizes.length > 0
                .mb-6
                  .flex.justify-between.items-center.mb-2
                    label.text-xs.font-bold.text-vamos-dark.uppercase.tracking-wider
                      | Kích Cỡ (EU Size)
                      span#selected-size-label.text-vamos-red.font-bold= `: ${availableSizes[0].name}`
                    span.text-xs.text-gray-400 Chuẩn form ôm chân
                  .flex.flex-wrap.gap-2
                    each sz, idx in availableSizes
                      label.cursor-pointer
                        input.sr-only.peer(
                          type="radio"
                          name="size"
                          value=sz.name
                          checked=idx === 0
                          required
                        )
                        .size-box(class="peer-checked:border-vamos-red peer-checked:bg-vamos-red peer-checked:text-white")
                          span= sz.name

              //- Quantity Stepper & Real-time Live Validation
              .mb-6
                .flex.items-center.justify-between.mb-2
                  label.text-xs.font-bold.text-vamos-dark.uppercase.tracking-wider(for="qty-input") Số Lượng
                  span.text-xs.text-gray-400 (Tối đa 10 đôi / đơn hàng lẻ)
                .flex.items-center.gap-3
                  .flex.items-center.border.border-gray-200.rounded-lg.overflow-hidden.bg-white.transition-all#qty-stepper-box
                    button#qty-minus-btn.px-3.py-2.text-gray-600.transition-colors(class="hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed" type="button" aria-label="Giảm số lượng") -
                    input#qty-input.w-14.py-2.text-center.text-sm.font-bold.border-none.bg-transparent.transition-colors(
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      max="10"
                      autocomplete="off"
                      oninput="if(window.handleDetailQtyChange)window.handleDetailQtyChange()"
                      onkeyup="if(window.handleDetailQtyChange)window.handleDetailQtyChange()"
                    )
                    button#qty-plus-btn.px-3.py-2.text-gray-600.transition-colors(class="hover:bg-gray-100 disabled:opacity-40 disabled:cursor-not-allowed" type="button" aria-label="Tăng số lượng") +
                  #stock-status-badge.text-xs.font-semibold.flex.items-center.gap-1.transition-colors
                    span.text-green-600 ✓ Còn hàng trong kho

                //- Dynamic Instant Validation Message (Appears immediately as user types)
                #qty-validation-msg.mt-2.p-2.rounded-lg.text-xs.font-bold.transition-all.duration-200.hidden

                script.
                  (function() {
                    function instantQtyCheck() {
                      const inp = document.getElementById('qty-input');
                      const msg = document.getElementById('qty-validation-msg');
                      const box = document.getElementById('qty-stepper-box');
                      const addBtn = document.getElementById('btn-add-to-cart');
                      const buyBtn = document.getElementById('btn-buy-now');
                      if (!inp || !msg) return;

                      const val = inp.value.trim();
                      const n = parseInt(val, 10);

                      if (!val || isNaN(n) || n < 1) {
                        msg.className = 'mt-2 p-3 bg-red-50 border border-red-200 rounded-lg text-xs font-bold text-red-700 block leading-relaxed';
                        msg.textContent = '⚠️ Vui lòng nhập số lượng hợp lệ (từ 1 đến 10 đôi).';
                        msg.classList.remove('hidden');
                        if (addBtn) addBtn.disabled = true;
                        if (buyBtn) buyBtn.disabled = true;
                        return;
                      }

                      if (n > 10) {
                        msg.className = 'mt-2 p-3 bg-amber-50 border border-amber-300 rounded-lg text-xs font-bold text-amber-900 block leading-relaxed animate-pulse';
                        msg.textContent = '⚠️ Bạn đang nhập ' + n + ' đôi. Có ai đặt ' + n + ' đôi cho một đơn hàng bán lẻ không? Đơn hàng bán lẻ trên website tối đa 10 đôi/lần đặt để đảm bảo công bằng cho mọi khách hàng. Nếu quý khách có nhu cầu mua sỉ số lượng lớn (' + n + ' đôi), vui lòng liên hệ Hotline 1900 2126 để nhận báo giá sỉ ưu đãi!';
                        msg.classList.remove('hidden');
                        if (addBtn) addBtn.disabled = true;
                        if (buyBtn) buyBtn.disabled = true;
                        if (box) {
                          box.classList.add('border-amber-400', 'ring-2', 'ring-amber-200', 'bg-amber-50/20');
                          box.classList.remove('border-gray-200');
                        }
                        return;
                      }

                      // Valid: Hide message and re-enable buttons
                      msg.classList.add('hidden');
                      msg.textContent = '';
                      if (box) {
                        box.classList.remove('border-amber-400', 'ring-2', 'ring-amber-200', 'bg-amber-50/20', 'border-red-500', 'ring-red-200', 'bg-red-50/20');
                        box.classList.add('border-gray-200');
                      }
                      if (addBtn) addBtn.disabled = false;
                      if (buyBtn) buyBtn.disabled = false;
                    }

                    window.handleDetailQtyChange = instantQtyCheck;
                    const inpEl = document.getElementById('qty-input');
                    if (inpEl) {
                      inpEl.addEventListener('input', instantQtyCheck);
                      inpEl.addEventListener('keyup', instantQtyCheck);
                      inpEl.addEventListener('change', instantQtyCheck);
                    }
                  })();

              //- Action Buttons
              .flex.flex-col.gap-3.mb-6(class="sm:flex-row")
                button#btn-add-to-cart.flex-1.btn-outline-red.text-xs(class="py-3.5 transition-all" type="submit")
                  svg.w-4.h-4.mr-1(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                    path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z")
                  | Thêm Vào Giỏ Hàng
                button#btn-buy-now.flex-1.btn-primary.text-xs(class="py-3.5 transition-all" type="submit" formaction="/cart/buy-now")
                  | Mua Ngay (COD)

          //- COD Guarantees Callout
          .border-t.border-gray-100.pt-5.grid.grid-cols-2.gap-3.text-xs.text-gray-600
            .flex.items-center.gap-2
              span 💵
              span Nhận hàng kiểm tra thanh toán COD
            .flex.items-center.gap-2
              span 🔄
              span Đổi size miễn phí trong 7 ngày
            .flex.items-center.gap-2
              span 🛡️
              span Cam kết chính hãng 100%
            .flex.items-center.gap-2
              span 📦
              span Đóng gói hộp đôi chống va đập

    //- ── 3 TECHNICAL SPECIFICATION CARDS (Stitch Design Handoff) ──
    .mt-10.grid.grid-cols-1.gap-6(class="md:grid-cols-3")
      .bg-white.p-6.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card
        .w-10.h-10.rounded-lg.bg-red-50.text-vamos-red.flex.items-center.justify-center.font-bold.text-lg.mb-4 ⚡
        h3.font-bold.text-vamos-dark.text-sm.mb-2 Đế Phylon Siêu Nhẹ & Đàn Hồi
        p.text-xs.text-gray-500.leading-relaxed Giảm 40% trọng lượng so với cao su thông thường, chống trơn trượt trên mặt ẩm ướt với độ hoàn trả lực trên 65%.

      .bg-white.p-6.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card
        .w-10.h-10.rounded-lg.bg-orange-50.text-vamos-orange.flex.items-center.justify-center.font-bold.text-lg.mb-4 🧶
        h3.font-bold.text-vamos-dark.text-sm.mb-2 Công Nghệ Dệt Liteknit Co Giãn
        p.text-xs.text-gray-500.leading-relaxed Thoáng khí tối đa 24/7, ôm sát vòm bàn chân tự nhiên, hạn chế tích tụ mồ hôi trong suốt ngày dài vận động.

      .bg-white.p-6.rounded-vamos-xl.border.border-vamos-border.shadow-vamos-card
        .w-10.h-10.rounded-lg.bg-green-50.text-green-600.flex.items-center.justify-center.font-bold.text-lg.mb-4 🌿
        h3.font-bold.text-vamos-dark.text-sm.mb-2 Lót Giày Kháng Khuẩn Nano Bạc
        p.text-xs.text-gray-500.leading-relaxed Lót mút xốp vi hạt than hoạt tính kết hợp ion Nano Bạc khử mùi hiệu quả, mang lại cảm giác êm ái từng bước chạy.

    //- ── PRODUCT DESCRIPTION DETAIL ──
    .mt-8.bg-white.rounded-vamos-xl.border.border-vamos-border.p-6.shadow-vamos-card(class="lg:p-10")
      h2.text-base.font-bold.text-vamos-dark.border-b.border-gray-100.pb-4.mb-4(style="font-family:'Space Grotesk',sans-serif") CHI TIẾT SẢN PHẨM & QUY CÁCH
      .text-sm.text-gray-600.leading-relaxed.space-y-4
        p= product.description || 'Sản phẩm được gia công tỉ mỉ bằng vật liệu cao cấp, đường may chắc chắn và thiết kế thể thao hiện đại.'
        .grid.grid-cols-2.gap-4.pt-2(class="md:grid-cols-4")
          .p-3.bg-vamos-bg-light.rounded-lg
            .text-xs.text-gray-400 Thương hiệu
            .text-sm.font-bold.text-vamos-dark= product.brand_name || 'VAMOS'
          .p-3.bg-vamos-bg-light.rounded-lg
            .text-xs.text-gray-400 Phân loại
            .text-sm.font-bold.text-vamos-dark= product.category_name || 'Giày sneaker'
          .p-3.bg-vamos-bg-light.rounded-lg
            .text-xs.text-gray-400 Đối tượng
            .text-sm.font-bold.text-vamos-dark= product.gender_target
          .p-3.bg-vamos-bg-light.rounded-lg
            .text-xs.text-gray-400 Thanh toán
            .text-sm.font-bold.text-vamos-red COD toàn quốc

    //- ── ACCORDION: HƯỚNG DẪN VỆ SINH & BẢO QUẢN (Stitch Design Handoff) ──
    .mt-6.bg-white.rounded-vamos-xl.border.border-vamos-border.p-6.shadow-vamos-card
      details.group
        summary.flex.items-center.justify-between.cursor-pointer.list-none.text-sm.font-bold.text-vamos-dark
          span.flex.items-center.gap-2
            span 🧼
            | Hướng Dẫn Vệ Sinh & Bảo Quản Giày VAMOS Chuẩn Nhà Sản Xuất
          span.text-xs.text-gray-400.transition-transform.duration-200(class="group-open:rotate-180") ▼
        .mt-4.pt-4.border-t.border-gray-100.text-xs.text-gray-600.space-y-2.leading-relaxed
          p • 
            strong Vệ sinh định kỳ: 
            | Dùng bàn chải lông mềm hoặc khăn microfiber thấm nước xà phòng pha loãng để lau sạch vết bẩn nhẹ trên bề mặt vải hoặc da.
          p • 
            strong Tránh phơi nắng gắt: 
            | Phơi giày ở nơi râm mát, thoáng khí tự nhiên. Tuyệt đối không sấy nhiệt độ cao hoặc phơi dưới ánh nắng trực tiếp để tránh làm biến dạng đế Phylon và làm giòn keo dán.
          p • 
            strong Bảo quản giữ phom: 
            | Giữ lót đệm khô ráo, nhét giấy mềm hoặc túi hút ẩm chuyên dụng vào lòng giày khi cất trong hộp để giữ dáng giày luôn chuẩn form.

    //- ── RELATED PRODUCTS SECTION (Stitch C-DET-02) ──
    if relatedProducts && relatedProducts.length > 0
      .mt-12
        .flex.items-center.justify-between.mb-6
          div
            span.text-xs.font-bold.text-vamos-red.uppercase.tracking-wider GỢI Ý CHO BẠN
            h2.text-xl.font-black.text-vamos-dark(style="font-family:'Space Grotesk',sans-serif") SẢN PHẨM CÙNG BỘ SƯU TẬP
          a.text-xs.font-bold.text-vamos-red(class="hover:underline flex items-center gap-1" href="/products")
            | Xem tất cả sản phẩm
            span →
        .grid.grid-cols-2.gap-4(class="sm:grid-cols-4 lg:gap-6")
          each relP in relatedProducts
            article.group.bg-white.rounded-vamos-xl.border.border-vamos-border.overflow-hidden.flex.flex-col.transition-all.duration-200.shadow-vamos-card(class="hover:-translate-y-1 hover:shadow-vamos-hover")
              a.relative.aspect-square.bg-slate-50.p-4.flex.items-center.justify-center.overflow-hidden(href=`/products/${relP.slug}`)
                if relP.primary_image || relP.image_url
                  img.w-full.h-full.object-contain.mix-blend-multiply.transition-transform.duration-300(class="group-hover:scale-105" src=(relP.primary_image || relP.image_url) alt=relP.name)
                else
                  .text-gray-400.text-xs VAMOS
                - const relDiscount = relP.sale_price && Number(relP.sale_price) > 0 && Number(relP.sale_price) < Number(relP.base_price) ? Math.round((1 - (Number(relP.sale_price) / Number(relP.base_price))) * 100) : 0
                if relDiscount > 0
                  span.badge-sale.absolute.top-2.left-2= `-${relDiscount}%`
              .p-4.flex.flex-col.flex-1.justify-between
                div
                  span.text-xs.text-gray-400= relP.gender_target || 'UNISEX'
                  h3.text-xs.font-bold.text-vamos-dark.line-clamp-2.mt-1(class="group-hover:text-vamos-red transition-colors")
                    a(href=`/products/${relP.slug}`)= relP.name
                .mt-3.flex.items-baseline.gap-2
                  if relP.sale_price && Number(relP.sale_price) > 0 && Number(relP.sale_price) < Number(relP.base_price)
                    span.text-sm.font-bold.text-vamos-red(style="font-family:'Space Grotesk',sans-serif")
                      = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(relP.sale_price)
                    span.text-xs.text-gray-400.line-through
                      = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(relP.base_price)
                  else
                    span.text-sm.font-bold.text-vamos-dark(style="font-family:'Space Grotesk',sans-serif")
                      = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(relP.base_price)

    script.
      window.PRODUCT_DATA = {
        id: #{product.id},
        name: !{JSON.stringify(product.name)},
        product_code: !{JSON.stringify(product.product_code)},
        base_price: #{product.base_price || 0},
        sale_price: #{product.sale_price || 'null'},
        variants: !{JSON.stringify(product.variants || [])}
      };
