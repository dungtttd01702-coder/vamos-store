extends ../../layouts/main

block content
  .container.mx-auto.px-4.py-20.text-center
    .max-w-md.mx-auto
      .text-9xl.font-black.text-vamos-red.mb-4 403
      h1.text-2xl.font-bold.text-gray-800.mb-2 Truy Cập Bị Từ Chối
      p.text-sm.text-gray-600.mb-8
        = message || 'Bạn không có quyền truy cập vào tài nguyên hoặc khu vực này trên hệ thống VAMOS STORE.'
      .flex.justify-center.space-x-4
        a.btn-primary(href="/") Về Trang Chủ
        a.btn-outline(href="/products") Xem Cửa Hàng
