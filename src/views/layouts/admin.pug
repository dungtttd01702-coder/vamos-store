include ../partials/date-helpers
doctype html
html(lang=currentLocale || "vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title ? `${title} | VAMOS STORE Admin Portal` : 'VAMOS STORE - Quản Trị Hệ Thống'
    link(rel="icon" type="image/x-icon" href="/images/favicon.ico")
    //- Google Fonts: Space Grotesk + Be Vietnam Pro
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    //- Google Material Symbols Outlined (Stitch Protocol)
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet")
    //- Compiled Tailwind CSS
    link(rel="stylesheet" href="/css/style.css")

    //- Inline theme initialization script to avoid FOUC
    script.
      (function() {
        try {
          var theme = localStorage.getItem('vamos_theme');
          if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();

    block styles

  body.min-h-screen.flex.flex-col.bg-slate-50.text-slate-900.transition-colors(class="dark:bg-slate-950 dark:text-slate-100")
    //- Dedicated Admin Header & Sub-Navigation
    include ../partials/admin-nav

    //- Flash message notifications
    if success_msg && success_msg.length > 0
      .vamos-container.mt-4
        .alert-dismissible.flex.items-center.gap-3.bg-green-50.border.border-green-200.text-green-800.p-4.rounded-vamos-lg.shadow-sm(class="dark:bg-green-950/60 dark:border-green-800 dark:text-green-300")
          span.text-lg ✅
          span= success_msg

    if error_msg && error_msg.length > 0
      .vamos-container.mt-4
        .alert-dismissible.flex.items-center.gap-3.bg-red-50.border.border-red-200.text-red-800.p-4.rounded-vamos-lg.shadow-sm(class="dark:bg-red-950/60 dark:border-red-800 dark:text-red-300")
          span.text-lg ❌
          span= error_msg

    if warning_msg && warning_msg.length > 0
      .vamos-container.mt-4
        .alert-dismissible.flex.items-center.gap-3.bg-amber-50.border.border-amber-200.text-amber-800.p-4.rounded-vamos-lg.shadow-sm(class="dark:bg-amber-950/60 dark:border-amber-800 dark:text-amber-300")
          span.text-lg ⚠️
          span= warning_msg

    //- Main Content Block
    main.flex-grow
      block content

    //- Dedicated Admin Footer (Strictly isolated from customer storefront)
    footer.bg-slate-900.border-t.border-slate-800.text-slate-400.py-4.text-center.text-xs.mt-12(class="dark:bg-slate-950 dark:border-slate-800")
      .vamos-container.flex.flex-col.items-center.justify-between.gap-3(class="sm:flex-row")
        .flex.items-center.gap-2
          span.font-bold.text-slate-200 VAMOS STORE Admin Portal
          span •
          span Phiên bản 1.0 (MSSQL Live Data ACID)
        .flex.items-center.gap-4
          a.transition-colors(class="hover:text-white" href="/" target="_blank" rel="noopener noreferrer")
            | 🌐 Xem Cửa Hàng (Preview)
          span •
          span © 2026 VAMOS STORE. All rights reserved.

    //- Global client state
    script.
      window.IS_AUTHENTICATED = !{Boolean(isAuthenticated)};
      window.CURRENT_USER_ID = !{user ? user.id : 'null'};
      window.IS_ADMIN = true;

    //- Admin Client Scripts
    script(src="/js/main.js")
    block scripts
