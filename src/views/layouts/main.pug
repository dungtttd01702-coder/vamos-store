doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title ? `${title} | VAMOS STORE` : 'VAMOS STORE - Giày Sneaker & Thể Thao'
    link(rel="icon" type="image/x-icon" href="/images/favicon.ico")
    //- Google Fonts: Space Grotesk + Be Vietnam Pro
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet")
    //- Compiled Tailwind CSS
    link(rel="stylesheet" href="/css/style.css")
    block styles

  body.min-h-screen.flex.flex-col.bg-white
    //- Header
    include ../partials/header

    //- Flash message notifications
    if success_msg && success_msg.length > 0
      .vamos-container.mt-4
        .alert-dismissible.flex.items-center.gap-3.bg-green-50.border.border-green-200.text-green-800.p-4.rounded-vamos-lg.shadow-sm
          span.text-lg ✅
          span= success_msg

    if error_msg && error_msg.length > 0
      .vamos-container.mt-4
        .alert-dismissible.flex.items-center.gap-3.bg-red-50.border.border-red-200.text-red-800.p-4.rounded-vamos-lg.shadow-sm
          span.text-lg ❌
          span= error_msg

    if warning_msg && warning_msg.length > 0
      .vamos-container.mt-4
        .alert-dismissible.flex.items-center.gap-3.bg-amber-50.border.border-amber-200.text-amber-800.p-4.rounded-vamos-lg.shadow-sm
          span.text-lg ⚠️
          span= warning_msg

    //- Main Content Block
    main.flex-grow
      block content

    //- Footer
    include ../partials/footer

    //- ── GUEST WISHLIST LOGIN REQUIRED MODAL (Stitch Spec) ──
    #guest-wishlist-modal.fixed.inset-0.z-50.items-center.justify-center.p-4.hidden(role="dialog" aria-modal="true" aria-labelledby="modal-wishlist-title")
      .modal-backdrop.fixed.inset-0.bg-slate-900.bg-opacity-60.backdrop-blur-sm.transition-opacity
      #guest-wishlist-card.relative.bg-white.rounded-2xl.shadow-2xl.max-w-md.w-full.p-6.border.border-slate-100.overflow-hidden.transform.transition-all.duration-300.z-10.scale-95.opacity-0(class="sm:p-8")
        .absolute.w-36.h-36.bg-red-100.rounded-full.filter.blur-2xl.opacity-70.pointer-events-none(class="-right-12 -top-12")
        button#btn-close-wishlist-modal.absolute.top-4.right-4.w-8.h-8.rounded-full.bg-slate-100.text-slate-400.flex.items-center.justify-center.transition-colors(class="hover:bg-slate-200 hover:text-slate-700" type="button" aria-label="Đóng")
          svg.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

        .text-center
          .w-16.h-16.mx-auto.mb-4.rounded-2xl.bg-red-50.border.border-red-100.flex.items-center.justify-center.text-red-600.shadow-inner
            svg.w-9.h-9.animate-pulse(fill="currentColor" viewBox="0 0 24 24")
              path(d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z")

          span.inline-flex.items-center.rounded-full.text-2xs.font-black.bg-red-100.text-red-700.tracking-wider.uppercase.mb-2(class="px-2.5 py-0.5") 🔒 Tính Năng Thành Viên VAMOS
          h3#modal-wishlist-title.text-xl.font-black.text-slate-900.tracking-tight(style="font-family:'Space Grotesk',sans-serif") Yêu Cầu Đăng Nhập
          p.text-xs.text-slate-500.mt-2.leading-relaxed
            | Bạn đang duyệt web với tư cách #[strong.text-slate-700 Khách vãng lai]. Vui lòng đăng nhập hoặc tạo tài khoản để lưu sản phẩm vào #[strong.text-red-600 Danh Sách Yêu Thích] và nhận thông báo khi có ưu đãi đặc biệt!

          //- Preview product box (dynamic if opened from a specific product card)
          #wishlist-modal-product-preview.mt-4.p-3.bg-slate-50.rounded-xl.border.border-slate-200.flex.items-center.gap-3.text-left.hidden
            img#wishlist-modal-product-img.w-12.h-12.object-contain.bg-white.rounded-lg.border.border-slate-200.p-1(src="" alt="")
            .flex-1.min-w-0
              p#wishlist-modal-product-name.text-xs.font-bold.text-slate-800.truncate
              p#wishlist-modal-product-price.text-xs.font-black.text-red-600(class="mt-0.5")

          //- Action Buttons
          .mt-6.flex.flex-col(class="gap-2.5")
            a#btn-wishlist-login.w-full.py-3.px-4.bg-red-600.text-white.text-xs.font-black.rounded-xl.shadow-md.transition-all(
              class="hover:bg-red-700 shadow-red-500/25 hover:shadow-lg flex items-center justify-center gap-2"
              href="/auth/login"
            )
              svg.w-4.h-4(fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1")
              | ĐĂNG NHẬP NGAY
            a.w-full.bg-slate-100.text-slate-700.text-xs.font-bold.rounded-xl.transition-colors(
              class="py-2.5 px-4 hover:bg-slate-200 flex items-center justify-center gap-1.5"
              href="/auth/register"
            )
              | Chưa có tài khoản? Đăng ký miễn phí
            button#btn-wishlist-dismiss.w-full.py-2.text-xs.font-semibold.text-slate-400.transition-colors(
              class="hover:text-slate-600"
              type="button"
            )
              | Để sau

    //- Global Injected State
    script.
      window.IS_AUTHENTICATED = !{Boolean(isAuthenticated)};

    //- Client Scripts
    script(src="/js/main.js?v=3.2.0")
    block scripts

