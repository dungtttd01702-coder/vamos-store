//- Admin Navigation Header & Sub-Bar (Isolated Role Architecture)
.bg-neutral-900.text-white.py-4.border-b.border-neutral-800.shadow-md(class="dark:bg-slate-950 dark:border-slate-800")
  .vamos-container
    .flex.flex-col.gap-3(class="md:flex-row md:items-center md:justify-between")
      //- Left: Logo & Title
      .flex.items-center.gap-3
        a.flex.items-center.gap-1.group(href="/admin/dashboard")
          span.text-xl.font-black.tracking-tight.text-red-500(style="font-family:'Space Grotesk',sans-serif") VAMOS
          span.rounded-full.bg-red-500.inline-block(class="w-1.5 h-1.5")
        .h-5.w-px.bg-neutral-700.hidden(class="sm:block")
        div
          .flex.items-center.gap-2
            span.bg-red-600.text-white.font-black.rounded.tracking-widest.uppercase(class="px-2 py-0.5 text-[10px]") QUẢN TRỊ VIÊN
            span.text-xs.text-neutral-400 VAMOS STORE Admin Portal
          h1.text-lg.font-black(class="mt-0.5" style="font-family:'Space Grotesk',sans-serif")= title || 'Quản Trị Hệ Thống'

      //- Right: Controls (User badge, Theme, Lang, Preview, Logout)
      .flex.items-center.flex-wrap.gap-2
        if user
          .flex.items-center.gap-2.px-3.bg-neutral-800.rounded-lg.border.border-neutral-700.text-xs(class="py-1.5")
            span 👤
            span.font-semibold.text-neutral-200= user.full_name || user.email

        //- Theme Toggle Button (Light / Dark)
        button#theme-toggle-btn.p-2.rounded-lg.bg-neutral-800.border.border-neutral-700.text-neutral-300.transition-all(
          class="hover:text-amber-400 hover:bg-neutral-700"
          type="button"
          title="Chuyển chế độ Sáng / Tối"
          aria-label="Chuyển đổi giao diện Sáng / Tối"
        )
          //- Moon icon (show in light)
          svg.theme-icon-moon.w-4.h-4.block(class="dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z")
          //- Sun icon (show in dark)
          svg.theme-icon-sun.w-4.h-4.hidden(class="dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z")

        //- Language switcher
        .flex.items-center.gap-1.px-2.py-1.bg-neutral-800.rounded-lg.border.border-neutral-700.text-xs
          a.rounded.font-bold.transition-colors(
            class=(currentLocale === 'en' ? 'text-neutral-400 hover:text-white px-1.5 py-0.5' : 'bg-red-600 text-white px-1.5 py-0.5')
            href="/set-locale/vi"
            title="Tiếng Việt"
          ) VN
          span.text-neutral-600 /
          a.rounded.font-bold.transition-colors(
            class=(currentLocale === 'en' ? 'bg-red-600 text-white px-1.5 py-0.5' : 'text-neutral-400 hover:text-white px-1.5 py-0.5')
            href="/set-locale/en"
            title="English"
          ) EN

        //- Preview Storefront
        a.flex.items-center.px-3.bg-neutral-800.border.border-neutral-700.rounded-lg.text-xs.font-bold.text-neutral-300.transition-all(
          class="gap-1.5 py-1.5 hover:bg-neutral-700 hover:text-white"
          href="/"
          target="_blank"
          rel="noopener noreferrer"
        )
          span 🌐
          span.hidden(class="sm:inline") Xem Cửa Hàng

        //- Logout Action
        form(action="/auth/logout" method="POST" class="inline")
          input(type="hidden" name="_csrf" value=csrfToken)
          button.flex.items-center.gap-1.px-3.border.border-red-900.rounded-lg.text-xs.font-bold.text-red-400.transition-all(
            class="py-1.5 hover:bg-red-950/60 hover:text-red-300"
            type="submit"
          )
            span 🚪
            span Đăng xuất

    //- Navigation Tabs
    .mt-3.pt-3.border-t.border-neutral-800.flex.items-center.overflow-x-auto.no-scrollbar.text-xs(class="gap-1.5")
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/dashboard"
        class=(activeNav === 'dashboard' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 📊
        span Dashboard
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/orders"
        class=(activeNav === 'orders' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 📦
        span Đơn Hàng
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/products"
        class=(activeNav === 'products' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 👟
        span Sản Phẩm
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/inventory"
        class=(activeNav === 'inventory' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 🏬
        span Kho Hàng
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/customers"
        class=(activeNav === 'customers' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 👥
        span Khách Hàng
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/vouchers"
        class=(activeNav === 'vouchers' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 🎟️
        span Voucher
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/categories"
        class=(activeNav === 'categories' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 🏷️
        span Danh Mục & Brand
      a.px-3.py-2.rounded-lg.font-bold.transition-colors.flex.items-center(
        href="/admin/banners"
        class=(activeNav === 'banners' ? 'bg-red-600 text-white shadow-sm shadow-red-600/30 gap-1.5' : 'text-neutral-300 hover:text-white hover:bg-neutral-800 gap-1.5')
      )
        span 🖼️
        span Banners
