//- ══════════════════════════════════════════════════
//- VAMOS STORE – Header & Navigation (Stitch Kinetic Design)
//- 60-30-10 Color Rule | Space Grotesk | Sticky Blur
//- ══════════════════════════════════════════════════
header
  //- ── 1. TOP ANNOUNCEMENT BAR (Stitch Spec) ──
  .bg-neutral-900.text-white.border-b.border-neutral-800.text-xs.font-medium(style="height:38px")
    .max-w-7xl.mx-auto.px-4.h-full.flex.items-center.justify-between(class="sm:px-6 lg:px-8")
      //- Left: Hotline & Tra cứu
      .hidden.items-center.gap-4.text-neutral-400(class="lg:flex")
        a.flex.items-center.gap-1.transition-colors(class="hover:text-white" href="tel:19002126")
          svg.text-red-500(class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z")
          span= t('nav.hotline', 'Hotline: 1900 2126')
        span.text-neutral-600 |
        a.transition-colors(class="hover:text-white" href="/account/orders")= t('nav.order_tracking', 'Tra cứu đơn hàng')
        span.text-neutral-600 |
        a.transition-colors(class="hover:text-amber-400 text-amber-300 font-bold" href="/account/rewards") ✨ VAMOS Club

      //- Center: Value Propositions
      .mx-auto.flex.items-center.justify-center.gap-2.text-xs.tracking-wide
        span.text-amber-400.font-bold= '🔥 ' + t('nav.flash_sale', 'FLASH SALE TOÀN HỆ THỐNG')
        span.text-neutral-500.hidden(class="sm:inline") •
        span.hidden(class="sm:inline")= t('nav.free_shipping_notice', 'MIỄN PHÍ VẬN CHUYỂN TỪ 500K')
        span.text-neutral-500.hidden(class="sm:inline") •
        span.text-neutral-300.hidden(class="sm:inline")= t('nav.lifetime_warranty', 'BẢO HÀNH TRỌN ĐỜI')

      //- Right: Language & Support
      .hidden.items-center.gap-3.text-neutral-400(class="lg:flex")
        a.transition-colors.rounded.px-1(
          class=(currentLocale === 'vi' ? 'text-white font-bold bg-neutral-800' : 'hover:text-white text-neutral-400')
          href="/set-locale/vi"
          title="Tiếng Việt"
        ) VN
        span.text-neutral-600 /
        a.transition-colors.rounded.px-1(
          class=(currentLocale === 'en' ? 'text-white font-bold bg-neutral-800' : 'hover:text-white text-neutral-400')
          href="/set-locale/en"
          title="English"
        ) EN
        span.text-neutral-600 |
        a.transition-colors(class="hover:text-white" href="mailto:support@vamos.vn") support@vamos.vn

  //- ── 2. MAIN STICKY NAVBAR ──
  nav.sticky.top-0.w-full.z-50.bg-white.border-b.border-slate-200.transition-all.duration-200(style="background-color:rgba(255,255,255,0.95);backdrop-filter:blur(12px)")
    .max-w-7xl.mx-auto.px-2.h-20.flex.items-center.justify-between.gap-1(class="sm:px-6 sm:gap-4 lg:px-8")

      //- Brand Logo Anchor
      a.flex.items-center.gap-1.group.flex-shrink-0(href="/")
        span.text-xl.font-black.tracking-tight.text-red-600.transition-transform(class="sm:text-2xl group-hover:scale-105" style="font-family:'Space Grotesk',sans-serif") VAMOS
        span.rounded-full.bg-red-600.inline-block(class="w-1.5 h-1.5 sm:w-2 sm:h-2")
        span.text-xs.font-black.tracking-widest.text-slate-900(class="ml-0.5 sm:ml-1" style="font-family:'Space Grotesk',sans-serif") STORE

      //- Desktop Navigation Categories (Visible only on lg: >= 1024px)
      .hidden.items-center.gap-6.text-sm.font-semibold.text-slate-700(class="lg:flex")
        a.transition-colors.pb-1(class="hover:text-red-600" href="/products?cat=sneaker-nam")= t('nav.sneaker_men', 'Sneaker Nam')
        a.transition-colors.pb-1(class="hover:text-red-600" href="/products?cat=sneaker-nu")= t('nav.sneaker_women', 'Sneaker Nữ')
        a.transition-colors.pb-1(class="hover:text-red-600" href="/products?cat=giay-the-thao")= t('nav.sport_shoes', 'Giày Thể Thao')
        a.transition-colors.pb-1(class="hover:text-red-600" href="/products?cat=sandal-dep")= t('nav.sandals', 'Sandal & Dép')
        a.text-red-600.font-bold.flex.items-center.pb-1(class="gap-1.5 hover:text-red-700" href="/promotions")
          span= '🔥 ' + t('nav.promotions', 'Khuyến Mãi')
          span.text-white.bg-red-600.font-bold.rounded-full.leading-none(class="px-1.5 py-0.5" style="font-size:10px") HOT

      //- Right Actions: Search + Cart + Account + Mobile Toggle
      .flex.items-center.gap-1(class="sm:gap-2 lg:gap-3")

        //- Live Search Input (Desktop)
        .hidden.relative#desktop-search-container(class="lg:block")
          form#desktop-search-form.relative.flex.items-center(action="/products" method="GET")
            input#desktop-search-input.w-56.pl-9.pr-8.py-2.text-xs.bg-slate-100.rounded-lg.border.border-transparent.transition-all(
              class="focus:w-72 focus:bg-white focus:border-red-600 focus:outline-none focus:ring-1 focus:ring-red-600"
              type="text"
              name="q"
              placeholder=t('nav.search_placeholder', 'Tìm kiếm giày, sandal...')
              autocomplete="off"
            )
            svg.w-4.h-4.text-slate-400.absolute.left-3.pointer-events-none(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
            button#desktop-search-clear.hidden.absolute.text-slate-400(class="right-2.5 hover:text-slate-600" type="button" aria-label="Xóa tìm kiếm")
              svg(class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

          //- Live Search Dropdown
          #desktop-search-dropdown.absolute.left-0.w-80.mt-2.bg-white.rounded-xl.shadow-2xl.border.border-slate-200.overflow-hidden.z-50.hidden(style="top:100%")

        //- Theme Toggle Button (Desktop Navbar)
        button#storefront-theme-toggle.text-slate-600.rounded-full.transition-colors(
          class="p-1.5 sm:p-2 hover:text-amber-500 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800"
          type="button"
          title="Chuyển chế độ Sáng / Tối"
          aria-label="Chuyển đổi giao diện Sáng / Tối"
        )
          svg.theme-icon-moon.w-5.h-5.block(class="dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z")
          svg.theme-icon-sun.w-5.h-5.hidden(class="dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z")

        if !isAdmin
          //- Wishlist Heart Action (Customer & Guest only)
          button#header-wishlist-btn.text-slate-700.rounded-full.transition-colors.relative(class="p-1.5 sm:p-2 hover:text-red-600 hover:bg-slate-100" type="button" title=t('nav.wishlist', 'Danh sách yêu thích'))
            svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z")
            span#header-wishlist-badge.absolute.top-0.right-0.w-4.h-4.bg-red-600.text-white.font-bold.rounded-full.items-center.justify-center.shadow-sm.hidden(style="font-size:9px") 0

          //- Shopping Cart Action (Customer & Guest only)
          a.text-slate-700.rounded-full.transition-colors.relative(class="p-1.5 sm:p-2 hover:text-red-600 hover:bg-slate-100" href="/cart" title=t('nav.cart', 'Giỏ hàng'))
            svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z")
            if cartCount > 0
              span.absolute.top-0.right-0.w-5.h-5.bg-red-600.text-white.font-bold.rounded-full.flex.items-center.justify-center.shadow-sm(style="font-size:10px") #{cartCount}
            else
              span.absolute.top-0.right-0.w-4.h-4.bg-slate-300.text-slate-700.font-bold.rounded-full.flex.items-center.justify-center(style="font-size:9px") 0
        else
          //- Admin Mode Portal Pill
          a.flex.items-center.px-2.bg-red-600.text-white.text-xs.font-bold.rounded-lg.shadow-sm.transition-all(
            class="sm:px-3 gap-1.5 py-1.5 hover:bg-red-700 shadow-red-500/20"
            href="/admin/dashboard"
            title=t('nav.admin_portal', 'Quản trị Admin')
          )
            span ⚙️
            span.hidden(class="sm:inline")= t('nav.admin_portal', 'Quản trị Admin')

        //- Account Actions
        if isAuthenticated
          .relative.group
            button.flex.items-center.text-xs.font-semibold.text-slate-800.p-1.rounded-lg.transition-colors(class="sm:px-2 sm:py-1.5 hover:bg-slate-100")
              span.w-7.h-7.rounded-full.bg-slate-900.text-white.flex.items-center.justify-center.font-bold.text-xs.uppercase(class="sm:w-8 sm:h-8")= (user.full_name || user.email).charAt(0)
              svg.text-slate-500.transition-transform.hidden(class="sm:block w-3.5 h-3.5 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")

            //- Dropdown Menu
            .absolute.right-0.w-56.mt-1.bg-white.rounded-xl.shadow-xl.border.border-slate-200.py-2.z-50.opacity-0.invisible.transition-all.duration-200(class="group-hover:opacity-100 group-hover:visible" style="top:calc(100% + 4px)")
              if isAdmin
                a.flex.items-center.gap-2.px-4.py-2.text-xs.font-bold.text-red-600.bg-red-50(href="/admin/dashboard")
                  span ⚙️
                  span= t('admin.portal_title', 'Trung Tâm Quản Trị')
                .h-px.bg-slate-100.my-1
              else
                a.flex.items-center.gap-2.px-4.py-2.text-xs.text-slate-700.transition-colors(class="hover:bg-slate-50 hover:text-red-600" href="/account/profile")
                  span 👤
                  span= t('nav.account_info', 'Thông tin tài khoản')
                a.flex.items-center.gap-2.px-4.py-2.text-xs.text-slate-700.transition-colors(class="hover:bg-slate-50 hover:text-red-600" href="/account/rewards")
                  span 🎁
                  span VAMOS Club (Điểm &amp; Voucher)
                a.flex.items-center.gap-2.px-4.py-2.text-xs.text-slate-700.transition-colors(class="hover:bg-slate-50 hover:text-red-600" href="/account/orders")
                  span 📦
                  span= t('nav.order_history', 'Lịch sử đơn hàng')
                a.flex.items-center.gap-2.px-4.py-2.text-xs.text-slate-700.transition-colors(class="hover:bg-slate-50 hover:text-red-600" href="/account/wishlist")
                  span ❤️
                  span Sản phẩm yêu thích
                a.flex.items-center.gap-2.px-4.py-2.text-xs.text-slate-700.transition-colors(class="hover:bg-slate-50 hover:text-red-600" href="/account/addresses")
                  span 📍
                  span= t('nav.address_book', 'Sổ địa chỉ')
                .h-px.bg-slate-100.my-1
              form(action="/auth/logout" method="POST")
                input(type="hidden" name="_csrf" value=csrfToken)
                button.flex.items-center.gap-2.w-full.text-left.px-4.py-2.text-xs.text-red-600.font-semibold.transition-colors(class="hover:bg-red-50" type="submit")
                  span 🚪
                  span= t('nav.logout', 'Đăng xuất')

        else
          //- Guest Auth for Tablet & Desktop (>= sm)
          .hidden.items-center.gap-2(class="sm:flex")
            a.text-xs.font-semibold.text-slate-700.px-3.py-2.rounded-lg.transition-colors(class="hover:text-red-600 hover:bg-slate-100" href="/auth/login")= t('nav.login', 'Đăng nhập')
            a.px-4.py-2.bg-red-600.text-white.text-xs.font-bold.rounded-lg.shadow-sm.transition-all(class="hover:bg-red-700 shadow-red-500/20 hover:shadow-md" href="/auth/register")= t('nav.register', 'Đăng ký')

          //- Guest Auth Icon for Mobile (< sm)
          a.p-2.text-slate-700.rounded-full.transition-colors(
            class="sm:hidden hover:text-red-600 hover:bg-slate-100"
            href="/auth/login"
            title=t('nav.login', 'Đăng nhập')
            aria-label=t('nav.login', 'Đăng nhập')
          )
            svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z")

        //- Mobile Menu Trigger (Visible on < lg: 1024px)
        button#mobile-menu-btn.text-slate-700.rounded-lg.transition-colors(class="p-1.5 sm:p-2 lg:hidden hover:bg-slate-100")
          svg.w-6.h-6(fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16")

  //- ── 3. MOBILE MENU (Visible when toggled on < lg) ──
  #mobile-menu.bg-white.border-b.border-slate-200.px-4.py-4.space-y-3(class="hidden lg:hidden")
    .relative#mobile-search-container
      form#mobile-search-form.relative.flex.items-center(action="/products" method="GET")
        input#mobile-search-input.w-full.text-xs.bg-slate-100.rounded-lg.border.border-transparent.pl-9.pr-8(
          class="py-2.5 focus:bg-white focus:border-red-600 focus:outline-none"
          type="text"
          name="q"
          placeholder="Tìm kiếm giày, sandal..."
          autocomplete="off"
        )
        svg.w-4.h-4.text-slate-400.absolute.left-3.pointer-events-none(fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
        button#mobile-search-clear.hidden.absolute.text-slate-400(class="right-2.5" type="button" aria-label="Xóa")
          svg(class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")
      #mobile-search-dropdown.w-full.mt-2.bg-white.rounded-xl.shadow-2xl.border.border-slate-200.overflow-hidden.hidden

    nav.flex.flex-col.space-y-2.pt-2.border-t.border-slate-100.text-xs.font-semibold
      a.py-2.px-3.rounded-lg(class="hover:bg-slate-50 hover:text-red-600" href="/products?cat=sneaker-nam") Sneaker Nam
      a.py-2.px-3.rounded-lg(class="hover:bg-slate-50 hover:text-red-600" href="/products?cat=sneaker-nu") Sneaker Nữ
      a.py-2.px-3.rounded-lg(class="hover:bg-slate-50 hover:text-red-600" href="/products?cat=giay-the-thao") Giày Thể Thao
      a.py-2.px-3.rounded-lg(class="hover:bg-slate-50 hover:text-red-600" href="/products?cat=sandal-dep") Sandal & Dép
      a.py-2.px-3.rounded-lg.text-red-600.font-bold(class="hover:bg-red-50" href="/promotions") 🔥 Khuyến Mãi HOT

    if !isAuthenticated
      .pt-2.border-t.border-slate-100.flex.flex-col.gap-2(class="sm:hidden")
        a.flex.items-center.justify-center.py-2.px-4.text-xs.font-semibold.text-slate-700.rounded-lg.bg-slate-100(class="hover:bg-slate-200" href="/auth/login")= t('nav.login', 'Đăng nhập')
        a.flex.items-center.justify-center.py-2.px-4.text-xs.font-bold.text-white.rounded-lg.bg-red-600(class="hover:bg-red-700" href="/auth/register")= t('nav.register', 'Đăng ký')

    .pt-2.border-t.border-slate-100.flex.items-center.justify-between.text-xs.text-slate-500
      span= t('nav.language', 'Ngôn ngữ')
      .flex.items-center.gap-2
        a.rounded.px-2.py-1(class=(currentLocale === 'vi' ? 'bg-slate-900 text-white font-bold' : 'hover:bg-slate-100 text-slate-700') href="/set-locale/vi") VN
        a.rounded.px-2.py-1(class=(currentLocale === 'en' ? 'bg-slate-900 text-white font-bold' : 'hover:bg-slate-100 text-slate-700') href="/set-locale/en") EN
