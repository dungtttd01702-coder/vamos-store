{
  "name": "vamos-store",
  "version": "1.0.0",
  "description": "Website thương mại điện tử chuyên kinh doanh giày dép VAMOS STORE",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node tests/regression_suite.js",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --watch"
  },
  "keywords": [
    "vamos-store",
    "ecommerce",
    "express",
    "pug",
    "tailwind",
    "mssql",
    "sqlserver"
  ],
  "author": "VAMOS STORE Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "morgan": "^1.10.0",
    "mssql": "^12.7.14",
    "pug": "^3.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17"
  }
}
